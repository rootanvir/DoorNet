<Window x:Class="DoorNet.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:controls="clr-namespace:DoorNet.App.Controls"
        mc:Ignorable="d"
        Title="DoorNet"
        Width="1240"
        Height="800"
        MinWidth="1020"
        MinHeight="660"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource CanvasBrush}"
        Foreground="{StaticResource TextPrimaryBrush}"
        FontFamily="{StaticResource UiFont}"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Header -->
        <Border Grid.Row="0"
                Height="64"
                Background="#0D1319"
                BorderBrush="{StaticResource LineBrush}"
                BorderThickness="0,0,0,1">
            <Grid Margin="20,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Border Width="30" Height="30" CornerRadius="9" Background="#13231C" BorderBrush="#1F4A36" BorderThickness="1">
                        <TextBlock Text="D"
                                   FontFamily="{StaticResource DisplayFont}"
                                   FontSize="15"
                                   FontWeight="Bold"
                                   Foreground="{StaticResource DownloadBrush}"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center" />
                    </Border>
                    <StackPanel Margin="11,0,0,0" VerticalAlignment="Center">
                        <TextBlock Text="DoorNet" FontSize="14" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}" />
                        <TextBlock Text="{Binding AdapterSummary}"
                                   Style="{StaticResource Caption}"
                                   MaxWidth="340"
                                   TextTrimming="CharacterEllipsis"
                                   Margin="0,1,0,0" />
                    </StackPanel>
                </StackPanel>

                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                    <Border Padding="10,5" CornerRadius="20" BorderThickness="1" ToolTip="{Binding LastError}">
                        <Border.Style>
                            <Style TargetType="Border">
                                <Setter Property="Background" Value="#10251C" />
                                <Setter Property="BorderBrush" Value="#1C4632" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsCapturing}" Value="False">
                                        <Setter Property="Background" Value="#171F27" />
                                        <Setter Property="BorderBrush" Value="#283542" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Border.Style>
                        <StackPanel Orientation="Horizontal">
                            <Ellipse Width="6" Height="6" Margin="0,0,6,0" VerticalAlignment="Center">
                                <Ellipse.Style>
                                    <Style TargetType="Ellipse">
                                        <Setter Property="Fill" Value="{StaticResource DownloadBrush}" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsCapturing}" Value="False">
                                                <Setter Property="Fill" Value="{StaticResource TextMutedBrush}" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Ellipse.Style>
                            </Ellipse>
                            <TextBlock Text="{Binding StatusText}"
                                       FontSize="11"
                                       FontWeight="SemiBold"
                                       Foreground="{StaticResource TextSecondaryBrush}" />
                        </StackPanel>
                    </Border>

                    <Button Content="{Binding CaptureButtonLabel}"
                            Command="{Binding ToggleCaptureCommand}"
                            Style="{StaticResource GhostButton}"
                            Margin="10,0,0,0" />
                    <Button Content="Reset session"
                            Command="{Binding ResetSessionCommand}"
                            Style="{StaticResource GhostButton}"
                            Margin="8,0,0,0" />
                    <Button Content="Restart elevated"
                            Command="{Binding RestartElevatedCommand}"
                            Style="{StaticResource GhostButton}"
                            Margin="8,0,0,0"
                            ToolTip="Relaunch with administrator rights to measure per-app byte usage"
                            Visibility="{Binding CanOfferElevation, Converter={StaticResource BoolToVis}}" />
                </StackPanel>
            </Grid>
        </Border>

        <!-- Content -->
        <Grid Grid.Row="1" Margin="20,16,20,14">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="2*" MinHeight="180" />
                <RowDefinition Height="3*" MinHeight="250" />
            </Grid.RowDefinitions>

            <!-- Metric tiles -->
            <Grid Grid.Row="0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <Border Grid.Column="0" Style="{StaticResource Card}" Margin="0,0,7,0">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <StackPanel Orientation="Horizontal">
                            <Ellipse Width="7" Height="7" Fill="{StaticResource DownloadBrush}" Margin="0,0,7,0" VerticalAlignment="Center" />
                            <TextBlock Text="DOWNLOAD" Style="{StaticResource TileLabel}" />
                        </StackPanel>

                        <StackPanel Grid.Row="1" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,6,0,0">
                            <TextBlock Text="{Binding DownValue}" Style="{StaticResource MetricValue}" Foreground="{StaticResource DownloadBrush}" />
                            <TextBlock Text="{Binding DownUnit}" Style="{StaticResource MetricUnit}" />
                        </StackPanel>

                        <TextBlock Grid.Row="2" Text="{Binding DownPeakText}" Style="{StaticResource Caption}" Margin="0,4,0,0" />
                    </Grid>
                </Border>

                <Border Grid.Column="1" Style="{StaticResource Card}" Margin="7,0,7,0">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <StackPanel Orientation="Horizontal">
                            <Ellipse Width="7" Height="7" Fill="{StaticResource UploadBrush}" Margin="0,0,7,0" VerticalAlignment="Center" />
                            <TextBlock Text="UPLOAD" Style="{StaticResource TileLabel}" />
                        </StackPanel>

                        <StackPanel Grid.Row="1" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,6,0,0">
                            <TextBlock Text="{Binding UpValue}" Style="{StaticResource MetricValue}" Foreground="{StaticResource UploadBrush}" />
                            <TextBlock Text="{Binding UpUnit}" Style="{StaticResource MetricUnit}" />
                        </StackPanel>

                        <TextBlock Grid.Row="2" Text="{Binding UpPeakText}" Style="{StaticResource Caption}" Margin="0,4,0,0" />
                    </Grid>
                </Border>

                <Border Grid.Column="2" Style="{StaticResource Card}" Margin="7,0,0,0">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <StackPanel Orientation="Horizontal">
                            <Rectangle Width="7" Height="7" Fill="{StaticResource TextMutedBrush}" RadiusX="1.5" RadiusY="1.5" Margin="0,0,7,0" VerticalAlignment="Center" />
                            <TextBlock Text="DATA THIS SESSION" Style="{StaticResource TileLabel}" />
                        </StackPanel>

                        <StackPanel Grid.Row="1" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,6,0,0">
                            <TextBlock Text="{Binding TotalValue}" Style="{StaticResource MetricValue}" />
                            <TextBlock Text="{Binding TotalUnit}" Style="{StaticResource MetricUnit}" />
                        </StackPanel>

                        <TextBlock Grid.Row="2" Text="{Binding SessionSplitText}" Style="{StaticResource Caption}" Margin="0,4,0,0" />
                    </Grid>
                </Border>
            </Grid>

            <!-- Chart -->
            <Border Grid.Row="1" Style="{StaticResource Card}" Margin="0,14,0,0" Padding="16,13,16,10">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <Grid>
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock Text="Throughput" Style="{StaticResource SectionTitle}" />
                            <Border Background="#18222C" CornerRadius="5" Padding="6,2" Margin="9,0,0,0" VerticalAlignment="Center">
                                <TextBlock Text="90 s window" FontSize="10" Foreground="{StaticResource TextMutedBrush}" />
                            </Border>
                        </StackPanel>

                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                            <Ellipse Width="7" Height="7" Fill="{StaticResource DownloadBrush}" Margin="0,0,6,0" VerticalAlignment="Center" />
                            <TextBlock Text="Download" Style="{StaticResource Caption}" Margin="0,0,16,0" />
                            <Ellipse Width="7" Height="7" Fill="{StaticResource UploadBrush}" Margin="0,0,6,0" VerticalAlignment="Center" />
                            <TextBlock Text="Upload" Style="{StaticResource Caption}" />
                        </StackPanel>
                    </Grid>

                    <controls:ThroughputChart Grid.Row="1"
                                              Points="{Binding ChartPoints}"
                                              Margin="0,10,0,0"
                                              MinHeight="130" />
                </Grid>
            </Border>

            <!-- Tables -->
            <Grid Grid.Row="2" Margin="0,14,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="1.05*" />
                    <ColumnDefinition Width="1.35*" />
                </Grid.ColumnDefinitions>

                <Border Grid.Column="0" Style="{StaticResource Card}" Margin="0,0,7,0" Padding="16,13,16,10">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <Grid>
                            <TextBlock Text="Top applications" Style="{StaticResource SectionTitle}" />
                            <TextBlock HorizontalAlignment="Right" VerticalAlignment="Center" Style="{StaticResource Caption}">
                                <Run Text="{Binding AppCount, Mode=OneWay}" />
                                <Run Text=" apps" />
                            </TextBlock>
                        </Grid>

                        <Grid Grid.Row="1" Margin="0,6,0,0">
                            <ScrollViewer VerticalScrollBarVisibility="Auto">
                                <ItemsControl ItemsSource="{Binding Apps}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border Padding="0,8"
                                                    BorderBrush="{StaticResource LineSoftBrush}"
                                                    BorderThickness="0,0,0,1"
                                                    ToolTip="{Binding Tooltip}">
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="Auto" />
                                                        <ColumnDefinition Width="*" />
                                                        <ColumnDefinition Width="Auto" />
                                                    </Grid.ColumnDefinitions>

                                                    <Border Width="30" Height="30" CornerRadius="8" Background="#16202A" BorderBrush="{StaticResource LineBrush}" BorderThickness="1">
                                                        <TextBlock Text="{Binding Initial}"
                                                                   FontSize="12"
                                                                   FontWeight="SemiBold"
                                                                   Foreground="{Binding Accent}"
                                                                   HorizontalAlignment="Center"
                                                                   VerticalAlignment="Center" />
                                                    </Border>

                                                    <StackPanel Grid.Column="1" Margin="10,0,8,0" VerticalAlignment="Center">
                                                        <TextBlock Text="{Binding Name}"
                                                                   FontSize="12.5"
                                                                   Foreground="{StaticResource TextPrimaryBrush}"
                                                                   TextTrimming="CharacterEllipsis" />
                                                        <TextBlock Text="{Binding DetailText}"
                                                                   Style="{StaticResource Caption}"
                                                                   Margin="0,2,0,0"
                                                                   TextTrimming="CharacterEllipsis" />
                                                    </StackPanel>

                                                    <StackPanel Grid.Column="2" VerticalAlignment="Center">
                                                        <TextBlock Text="{Binding TrafficText}"
                                                                   FontSize="11.5"
                                                                   FontWeight="SemiBold"
                                                                   Foreground="{StaticResource DownloadBrush}"
                                                                   HorizontalAlignment="Right"
                                                                   Margin="0,0,0,2"
                                                                   Visibility="{Binding HasTraffic, Converter={StaticResource BoolToVis}}" />
                                                        <TextBlock Text="{Binding ConnectionsText}"
                                                                   FontSize="11"
                                                                   Foreground="{StaticResource TextSecondaryBrush}"
                                                                   HorizontalAlignment="Right" />
                                                        <Ellipse Width="6" Height="6"
                                                                 Fill="{StaticResource DownloadBrush}"
                                                                 HorizontalAlignment="Right"
                                                                 Margin="0,4,0,0"
                                                                 Visibility="{Binding IsActive, Converter={StaticResource BoolToVis}}" />
                                                    </StackPanel>
                                                </Grid>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </ScrollViewer>

                            <TextBlock Text="Waiting for connection data…"
                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Center">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock" BasedOn="{StaticResource Caption}">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding Apps.Count}" Value="0">
                                                <Setter Property="Visibility" Value="Visible" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                        </Grid>

                        <TextBlock Grid.Row="2"
                                   Text="{Binding PerAppNote}"
                                   Style="{StaticResource Caption}"
                                   FontSize="10"
                                   TextWrapping="Wrap"
                                   Margin="0,8,0,0" />
                    </Grid>
                </Border>

                <Border Grid.Column="1" Style="{StaticResource Card}" Margin="7,0,0,0" Padding="16,13,10,10">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>

                        <Grid Margin="0,0,6,0">
                            <TextBlock Text="Live connections" Style="{StaticResource SectionTitle}" />
                            <TextBlock HorizontalAlignment="Right" VerticalAlignment="Center" Style="{StaticResource Caption}">
                                <Run Text="{Binding ConnectionCount, Mode=OneWay}" />
                                <Run Text=" sockets" />
                            </TextBlock>
                        </Grid>

                        <DataGrid Grid.Row="1"
                                  ItemsSource="{Binding Connections}"
                                  Margin="0,8,0,0"
                                  HeadersVisibility="Column"
                                  BorderThickness="0">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="APPLICATION"
                                                    Binding="{Binding ProcessName}"
                                                    Width="1.7*"
                                                    ElementStyle="{StaticResource CellTextStrong}" />
                                <DataGridTextColumn Header="PROTO"
                                                    Binding="{Binding Protocol}"
                                                    Width="52"
                                                    ElementStyle="{StaticResource CellText}" />
                                <DataGridTextColumn Header="LOCAL"
                                                    Binding="{Binding Local}"
                                                    Width="1.3*"
                                                    ElementStyle="{StaticResource CellText}" />
                                <DataGridTextColumn Header="REMOTE"
                                                    Binding="{Binding Remote}"
                                                    Width="1.4*"
                                                    ElementStyle="{StaticResource CellText}" />
                                <DataGridTemplateColumn Header="STATE" Width="98">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <StackPanel Orientation="Horizontal">
                                                <Ellipse Width="6" Height="6"
                                                         Fill="{Binding StateBrush}"
                                                         Margin="0,0,6,0"
                                                         VerticalAlignment="Center" />
                                                <TextBlock Text="{Binding State}"
                                                           FontSize="11.5"
                                                           Foreground="{StaticResource TextSecondaryBrush}"
                                                           VerticalAlignment="Center" />
                                            </StackPanel>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                            </DataGrid.Columns>
                        </DataGrid>
                    </Grid>
                </Border>
            </Grid>
        </Grid>

        <!-- Footer -->
        <Border Grid.Row="2"
                Height="34"
                Background="#0D1319"
                BorderBrush="{StaticResource LineBrush}"
                BorderThickness="0,1,0,0">
            <Grid Margin="20,0">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Ellipse Width="5" Height="5" Fill="{StaticResource TextMutedBrush}" Margin="0,0,7,0" VerticalAlignment="Center" />
                    <TextBlock Text="Samples every 1 s · in-process capture, no driver installed"
                               Style="{StaticResource Caption}"
                               FontSize="10.5" />
                </StackPanel>

                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                    <TextBlock Text="{Binding ElevationNote}" Style="{StaticResource Caption}" FontSize="10.5" />
                    <TextBlock Text="  ·  " Style="{StaticResource Caption}" FontSize="10.5" />
                    <TextBlock Text="{Binding VersionText}" Style="{StaticResource Caption}" FontSize="10.5" />
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Window>
