<Window x:Class="DoorNet.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:controls="clr-namespace:DoorNet.App.Controls"
        mc:Ignorable="d"
        Title="DoorNet"
        Width="1400"
        Height="1000"
        MinWidth="1180"
        MinHeight="780"
        WindowStartupLocation="CenterScreen"
        Background="{DynamicResource CanvasBrush}"
        Foreground="{DynamicResource TextPrimaryBrush}"
        FontFamily="{StaticResource UiFont}"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Header -->
        <Border Grid.Row="0"
                Height="64"
                Background="{DynamicResource HeaderBrush}"
                BorderBrush="{DynamicResource LineBrush}"
                BorderThickness="0,0,0,1">
            <Grid Margin="20,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0"
                            Orientation="Horizontal"
                            VerticalAlignment="Center">
                    <RadioButton x:Name="MonitorTab"
                                 GroupName="NavTabs"
                                 IsChecked="True"
                                 Style="{StaticResource HeaderTab}"
                                 Content="Monitor">
                        <RadioButton.Tag>
                            <TextBlock Text="&#xE9D9;" Style="{StaticResource HeaderIconGlyph}" />
                        </RadioButton.Tag>
                    </RadioButton>
                    <RadioButton x:Name="ScannerTab"
                                 GroupName="NavTabs"
                                 Style="{StaticResource HeaderTab}"
                                 Content="Scanner">
                        <RadioButton.Tag>
                            <!-- Globe with a magnifier in front of it, drawn so the globe strokes
                                 stop behind the lens instead of running through it. -->
                            <Canvas Width="17" Height="17" VerticalAlignment="Center">
                                <Path Style="{StaticResource HeaderIconStroke}" Clip="{StaticResource ScannerIconCut}">
                                    <Path.Data>
                                        <EllipseGeometry Center="10.4,7.8" RadiusX="5" RadiusY="5" />
                                    </Path.Data>
                                </Path>
                                <Path Style="{StaticResource HeaderIconStroke}" Clip="{StaticResource ScannerIconCut}">
                                    <Path.Data>
                                        <EllipseGeometry Center="10.4,7.8" RadiusX="2.3" RadiusY="5" />
                                    </Path.Data>
                                </Path>
                                <Path Style="{StaticResource HeaderIconStroke}" Clip="{StaticResource ScannerIconCut}">
                                    <Path.Data>
                                        <LineGeometry StartPoint="5.4,7.8" EndPoint="15.4,7.8" />
                                    </Path.Data>
                                </Path>

                                <Path Style="{StaticResource HeaderIconStroke}" StrokeThickness="1.6">
                                    <Path.Data>
                                        <EllipseGeometry Center="6,11.2" RadiusX="2.7" RadiusY="2.7" />
                                    </Path.Data>
                                </Path>
                                <Path Style="{StaticResource HeaderIconStroke}" StrokeThickness="1.8">
                                    <Path.Data>
                                        <LineGeometry StartPoint="8,13.2" EndPoint="10.4,15.6" />
                                    </Path.Data>
                                </Path>
                            </Canvas>
                        </RadioButton.Tag>
                    </RadioButton>
                    <RadioButton x:Name="TrafficTab"
                                 GroupName="NavTabs"
                                 Style="{StaticResource HeaderTab}"
                                 Content="Traffic">
                        <RadioButton.Tag>
                            <TextBlock Text="&#xE968;" Style="{StaticResource HeaderIconGlyph}" />
                        </RadioButton.Tag>
                    </RadioButton>
                    <RadioButton x:Name="AlertsTab"
                                 GroupName="NavTabs"
                                 Style="{StaticResource HeaderTab}"
                                 Content="{Binding AlertsTabLabel}">
                        <RadioButton.Tag>
                            <TextBlock Text="&#xEA8F;" Style="{StaticResource HeaderIconGlyph}" />
                        </RadioButton.Tag>
                    </RadioButton>
                    <RadioButton x:Name="RulesTab"
                                 GroupName="NavTabs"
                                 Style="{StaticResource HeaderTab}"
                                 Content="Rules">
                        <RadioButton.Tag>
                            <TextBlock Text="&#xE9D5;" Style="{StaticResource HeaderIconGlyph}" />
                        </RadioButton.Tag>
                    </RadioButton>
                    <RadioButton x:Name="ActionsTab"
                                 GroupName="NavTabs"
                                 Style="{StaticResource HeaderTab}"
                                 Content="Actions">
                        <RadioButton.Tag>
                            <TextBlock Text="&#xE945;" Style="{StaticResource HeaderIconGlyph}" />
                        </RadioButton.Tag>
                    </RadioButton>
                    <RadioButton x:Name="SettingsTab"
                                 GroupName="NavTabs"
                                 Style="{StaticResource HeaderTab}"
                                 Content="Settings">
                        <RadioButton.Tag>
                            <TextBlock Text="&#xE713;" Style="{StaticResource HeaderIconGlyph}" />
                        </RadioButton.Tag>
                    </RadioButton>
                </StackPanel>

                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button Command="{Binding ToggleFirewallCommand}"
                            Style="{StaticResource FirewallSwitch}"
                            ToolTip="{Binding FirewallTooltip}"
                            AutomationProperties.Name="Firewall master switch"
                            Margin="0,0,8,0" />

                    <!-- Theme toggle stays in the header: every tab needs it. -->
                    <Button Style="{StaticResource IconButton}"
                            Content="{Binding ThemeGlyph}"
                            ToolTip="{Binding ThemeTooltip}"
                            Command="{Binding ToggleThemeCommand}"
                            AutomationProperties.AutomationId="ThemeToggle"
                            AutomationProperties.Name="Switch theme"
                            VerticalAlignment="Center" />
                </StackPanel>

            </Grid>
        </Border>

        <!-- Views -->
        <Grid Grid.Row="1">
            <Grid Margin="20,16,20,14"
                  Visibility="{Binding IsChecked, ElementName=MonitorTab, Converter={StaticResource BoolToVis}}">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" MinHeight="240" />
            </Grid.RowDefinitions>

            <!-- Speed meter, meters and map -->
            <Grid Grid.Row="0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="1.55*" />
                    <ColumnDefinition Width="1*" />
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <Border Grid.Column="0" Grid.RowSpan="2" Style="{StaticResource Card}" Margin="0,0,7,0" Padding="16,13,16,10">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="*" />
                                </Grid.RowDefinitions>
            
                                <Grid>
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                        <TextBlock Text="Throughput" Style="{StaticResource SectionTitle}" />
                                        <Border Background="{DynamicResource SubtlePillBrush}" CornerRadius="5" Padding="6,2" Margin="9,0,0,0" VerticalAlignment="Center">
                                            <TextBlock Text="90 s window" FontSize="10" Foreground="{DynamicResource TextMutedBrush}" />
                                        </Border>
                                    </StackPanel>
            
                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                                        <Ellipse Width="7" Height="7" Fill="{DynamicResource DownloadBrush}" Margin="0,0,6,0" VerticalAlignment="Center" />
                                        <TextBlock Text="Download" Style="{StaticResource Caption}" Margin="0,0,16,0" />
                                        <Ellipse Width="7" Height="7" Fill="{DynamicResource UploadBrush}" Margin="0,0,6,0" VerticalAlignment="Center" />
                                        <TextBlock Text="Upload" Style="{StaticResource Caption}" />
                                    </StackPanel>
                                </Grid>
            
                                <controls:ThroughputChart Grid.Row="1"
                                                          Points="{Binding ChartPoints}"
                                                          DownloadBrush="{DynamicResource DownloadBrush}"
                                                          UploadBrush="{DynamicResource UploadBrush}"
                                                          GridBrush="{DynamicResource ChartGridBrush}"
                                                          LabelBrush="{DynamicResource ChartLabelBrush}"
                                                          Margin="0,10,0,0"
                                                          MinHeight="130" />
                            </Grid>
                        </Border>

                <Grid Grid.Row="0" Grid.Column="1" Grid.RowSpan="2" Margin="7,0,0,0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <Grid Grid.Row="0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <!-- Download -->
                        <Border Grid.Column="0" Style="{StaticResource Card}" Margin="0,0,7,0">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="*" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>

                                <StackPanel Orientation="Horizontal">
                                    <Ellipse Width="7" Height="7" Fill="{DynamicResource DownloadBrush}" Margin="0,0,7,0" VerticalAlignment="Center" />
                                    <TextBlock Text="DOWNLOAD" Style="{StaticResource TileLabel}" />
                                </StackPanel>

                                <StackPanel Grid.Row="1" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,6,0,0">
                                    <TextBlock Text="{Binding DownValue}">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock" BasedOn="{StaticResource MetricValue}">
                                                <Setter Property="Foreground" Value="{DynamicResource DownloadBrush}" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsNetworkIdle}" Value="True">
                                                        <Setter Property="Foreground" Value="{DynamicResource WarnBrush}" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                    <TextBlock Text="{Binding DownUnit}" Style="{StaticResource MetricUnit}" />
                                </StackPanel>

                                <TextBlock Grid.Row="2" Text="{Binding DownPeakText}" Style="{StaticResource Caption}" Margin="0,4,0,0" />
                            </Grid>
                        </Border>

                        <!-- Upload -->
                        <Border Grid.Column="1" Style="{StaticResource Card}" Margin="7,0,7,0">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="*" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>

                                <StackPanel Orientation="Horizontal">
                                    <Ellipse Width="7" Height="7" Fill="{DynamicResource UploadBrush}" Margin="0,0,7,0" VerticalAlignment="Center" />
                                    <TextBlock Text="UPLOAD" Style="{StaticResource TileLabel}" />
                                </StackPanel>

                                <StackPanel Grid.Row="1" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,6,0,0">
                                    <TextBlock Text="{Binding UpValue}">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock" BasedOn="{StaticResource MetricValue}">
                                                <Setter Property="Foreground" Value="{DynamicResource UploadBrush}" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsNetworkIdle}" Value="True">
                                                        <Setter Property="Foreground" Value="{DynamicResource WarnBrush}" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                    <TextBlock Text="{Binding UpUnit}" Style="{StaticResource MetricUnit}" />
                                </StackPanel>

                                <TextBlock Grid.Row="2" Text="{Binding UpPeakText}" Style="{StaticResource Caption}" Margin="0,4,0,0" />
                            </Grid>
                        </Border>

                        <!-- Session total -->
                        <Border Grid.Column="2" Style="{StaticResource Card}" Margin="7,0,0,0">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="*" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>

                                <StackPanel Orientation="Horizontal">
                                    <Rectangle Width="7" Height="7" Fill="{DynamicResource TextMutedBrush}" RadiusX="1.5" RadiusY="1.5" Margin="0,0,7,0" VerticalAlignment="Center" />
                                    <TextBlock Text="DATA THIS SESSION" Style="{StaticResource TileLabel}" />
                                </StackPanel>

                                <StackPanel Grid.Row="1" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,6,0,0">
                                    <TextBlock Text="{Binding TotalValue}" Style="{StaticResource MetricValue}" />
                                    <TextBlock Text="{Binding TotalUnit}" Style="{StaticResource MetricUnit}" />
                                </StackPanel>

                                <TextBlock Grid.Row="2" Text="{Binding SessionSplitText}" Style="{StaticResource Caption}" Margin="0,4,0,0" />
                            </Grid>
                        </Border>
                    </Grid>

                    <Border Grid.Row="1" Style="{StaticResource Card}" Margin="0,14,0,0" MinHeight="270" Padding="16,13,14,12">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>
    
                            <Grid Margin="0,0,2,0">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="Remote servers" Style="{StaticResource SectionTitle}" />
                                    <Border Background="{DynamicResource SubtlePillBrush}" CornerRadius="5" Padding="6,2" Margin="9,0,0,0" VerticalAlignment="Center">
                                        <TextBlock Text="{Binding RemoteHostCountText}" FontSize="10" Foreground="{DynamicResource TextMutedBrush}" />
                                    </Border>
                                </StackPanel>
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                                    <Border Padding="7,3"
                                            CornerRadius="20"
                                            BorderThickness="1"
                                            Margin="0,0,14,0"
                                            VerticalAlignment="Center"
                                            ToolTip="{Binding LastError}">
                                        <Border.Style>
                                            <Style TargetType="Border">
                                                <Setter Property="Background" Value="{DynamicResource LivePillBrush}" />
                                                <Setter Property="BorderBrush" Value="{DynamicResource LivePillBorderBrush}" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsCapturing}" Value="False">
                                                        <Setter Property="Background" Value="{DynamicResource PausedPillBrush}" />
                                                        <Setter Property="BorderBrush" Value="{DynamicResource PausedPillBorderBrush}" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Border.Style>
                                        <StackPanel Orientation="Horizontal">
                                            <Ellipse Width="5" Height="5" Margin="0,0,5,0" VerticalAlignment="Center">
                                                <Ellipse.Style>
                                                    <Style TargetType="Ellipse">
                                                        <Setter Property="Fill" Value="{DynamicResource DownloadBrush}" />
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding IsCapturing}" Value="False">
                                                                <Setter Property="Fill" Value="{DynamicResource TextMutedBrush}" />
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Ellipse.Style>
                                            </Ellipse>
                                            <TextBlock Text="{Binding StatusText}"
                                                       FontSize="10"
                                                       FontWeight="SemiBold"
                                                       Foreground="{DynamicResource TextSecondaryBrush}" />
                                        </StackPanel>
                                    </Border>
                                    <Ellipse Width="7" Height="7" Fill="{DynamicResource DownloadBrush}" Margin="0,0,6,0" />
                                    <TextBlock Text="Mine" Style="{StaticResource Caption}" Margin="0,0,14,0" />
                                    <Ellipse Width="7" Height="7" Fill="{DynamicResource DangerBrush}" Margin="0,0,6,0" />
                                    <TextBlock Text="Remote" Style="{StaticResource Caption}" />
                                </StackPanel>
                            </Grid>
    

                            <controls:WorldMapView Grid.Row="1"
                                                   Markers="{Binding MapMarkers}"
                                                   Margin="0,8,0,0"
                                                   LandBrush="{DynamicResource MapLandBrush}"
                                               OceanBrush="{DynamicResource MapOceanBrush}"
                                                   LocalBrush="{DynamicResource DownloadBrush}"
                                                   RemoteBrush="{DynamicResource DangerBrush}" />
                        </Grid>
                    </Border>
                </Grid>
            </Grid>





            <!-- Tables -->
            <Grid Grid.Row="1" Margin="0,14,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="1.25*" />
                    <ColumnDefinition Width="1.05*" />
                </Grid.ColumnDefinitions>

                <Border Grid.Column="0" Style="{StaticResource Card}" Margin="0,0,7,0" Padding="16,13,10,10">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <Grid Margin="0,0,6,0">
                            <TextBlock Text="Top applications" Style="{StaticResource SectionTitle}" />
                            <Button Content="Enable per-app meters"
                                    Command="{Binding RestartElevatedCommand}"
                                    Style="{StaticResource GhostButton}"
                                    FontSize="10"
                                    Padding="8,3"
                                    HorizontalAlignment="Right"
                                    Margin="0,0,64,0"
                                    VerticalAlignment="Center"
                                    ToolTip="Relaunch with administrator rights to measure per-app bytes"
                                    Visibility="{Binding ShowEnableMeters, Converter={StaticResource BoolToVis}}" />
                            <TextBlock HorizontalAlignment="Right" VerticalAlignment="Center" Style="{StaticResource Caption}">
                                <Run Text="{Binding AppCount, Mode=OneWay}" />
                                <Run Text=" apps" />
                            </TextBlock>
                        </Grid>

                        <Border Grid.Row="1"
                                Margin="0,10,9,0"
                                Padding="0,0,0,6"
                                BorderBrush="{DynamicResource LineSoftBrush}"
                                BorderThickness="0,0,0,1">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="20" />
                                    <ColumnDefinition Width="38" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="92" />
                                    <ColumnDefinition Width="92" />
                                    <ColumnDefinition Width="196" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Grid.ColumnSpan="3" Text="APPLICATION" Style="{StaticResource TableHeader}" />
                                <TextBlock Grid.Column="3" Text="DOWNLOAD" Style="{StaticResource TableHeader}" TextAlignment="Center" ToolTip="Download direction (inbound). Click the pill to block or allow it." />
                                <TextBlock Grid.Column="4" Text="UPLOAD" Style="{StaticResource TableHeader}" TextAlignment="Center" ToolTip="Upload direction (outbound). Click the pill to block or allow it." />
                                <Grid Grid.Column="5">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="74" />
                                        <ColumnDefinition Width="60" />
                                        <ColumnDefinition Width="62" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="1" Text="RATE" Style="{StaticResource TableHeader}" TextAlignment="Right" ToolTip="Live download / upload rate" />
                                    <TextBlock Grid.Column="2" Text="TOTAL" Style="{StaticResource TableHeader}" TextAlignment="Right" ToolTip="Bytes since DoorNet started" />
                                </Grid>
                            </Grid>
                        </Border>

                        <Grid Grid.Row="2">
                            <ScrollViewer VerticalScrollBarVisibility="Auto">
                                <ItemsControl ItemsSource="{Binding Apps}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border Padding="0,7"
                                                    BorderBrush="{DynamicResource LineSoftBrush}"
                                                    BorderThickness="0,0,0,1"
                                                    ToolTip="{Binding Tooltip}">
                                                <StackPanel>
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="20" />
                                                        <ColumnDefinition Width="38" />
                                                        <ColumnDefinition Width="*" />
                                                        <ColumnDefinition Width="92" />
                                                        <ColumnDefinition Width="92" />
                                                        <ColumnDefinition Width="196" />
                                                    </Grid.ColumnDefinitions>

                                                    <Button Grid.Column="0"
                                                            Command="{Binding DataContext.ToggleExpandCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                            CommandParameter="{Binding}"
                                                            VerticalAlignment="Center"
                                                            ToolTip="Show or hide this application's processes">
                                                        <Button.Style>
                                                            <Style TargetType="Button" BasedOn="{StaticResource ExpandButton}">
                                                                <Setter Property="Content" Value="&#xE76C;" />
                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{Binding IsExpanded}" Value="True">
                                                                        <Setter Property="Content" Value="&#xE70D;" />
                                                                    </DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </Button.Style>
                                                    </Button>

                                                    <Border Grid.Column="1" Width="30" Height="30" CornerRadius="8">
                                                        <Border.Style>
                                                            <Style TargetType="Border">
                                                                <Setter Property="Background" Value="{DynamicResource BadgeBrush}" />
                                                                <Setter Property="BorderBrush" Value="{DynamicResource LineBrush}" />
                                                                <Setter Property="BorderThickness" Value="1" />
                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{Binding HasIcon}" Value="True">
                                                                        <Setter Property="Background" Value="Transparent" />
                                                                        <Setter Property="BorderBrush" Value="Transparent" />
                                                                        <Setter Property="BorderThickness" Value="0" />
                                                                    </DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </Border.Style>
                                                        <Grid>
                                                            <TextBlock Text="{Binding Initial}"
                                                                       FontSize="12"
                                                                       FontWeight="SemiBold"
                                                                       Foreground="{Binding Accent}"
                                                                       HorizontalAlignment="Center"
                                                                       VerticalAlignment="Center">
                                                                <TextBlock.Style>
                                                                    <Style TargetType="TextBlock">
                                                                        <Setter Property="Visibility" Value="Visible" />
                                                                        <Style.Triggers>
                                                                            <DataTrigger Binding="{Binding HasIcon}" Value="True">
                                                                                <Setter Property="Visibility" Value="Hidden" />
                                                                            </DataTrigger>
                                                                        </Style.Triggers>
                                                                    </Style>
                                                                </TextBlock.Style>
                                                            </TextBlock>
                                                            <Image Source="{Binding Icon}"
                                                                   Width="21"
                                                                   Height="21"
                                                                   HorizontalAlignment="Center"
                                                                   VerticalAlignment="Center"
                                                                   RenderOptions.BitmapScalingMode="HighQuality"
                                                                   Visibility="{Binding HasIcon, Converter={StaticResource BoolToVis}}" />
                                                        </Grid>
                                                    </Border>

                                                    <StackPanel Grid.Column="2" Margin="0,0,8,0" VerticalAlignment="Center">
                                                        <TextBlock Text="{Binding Name}"
                                                                   FontSize="12.5"
                                                                   Foreground="{DynamicResource TextPrimaryBrush}"
                                                                   TextTrimming="CharacterEllipsis" />
                                                        <TextBlock Text="{Binding DetailText}"
                                                                   Style="{StaticResource Caption}"
                                                                   Margin="0,2,0,0"
                                                                   TextTrimming="CharacterEllipsis" />
                                                    </StackPanel>

                                                    <Button Grid.Column="3"
                                                            VerticalAlignment="Center"
                                                            HorizontalAlignment="Center"
                                                            Click="OpenPillMenu"
                                                            Tag="{Binding DataContext, RelativeSource={RelativeSource AncestorType=Window}}"
                                                            IsEnabled="{Binding DataContext.IsFirewallEnabled, RelativeSource={RelativeSource AncestorType=Window}}"
                                                            AutomationProperties.Name="Download access"
                                                            ToolTip="Change download (inbound) access">
                                                        <Button.ContextMenu>
                                                            <ContextMenu Style="{StaticResource AccessMenu}">
                                                                <MenuItem Command="{Binding PlacementTarget.Tag.ToggleDownloadCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                                                          CommandParameter="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource AncestorType=ContextMenu}}">
                                                                    <MenuItem.Style>
                                                                        <Style TargetType="MenuItem" BasedOn="{StaticResource AccessMenuItem}">
                                                                            <Setter Property="Background" Value="{DynamicResource DangerSoftBrush}" />
                                                                            <Setter Property="BorderBrush" Value="{DynamicResource DangerSoftBorderBrush}" />
                                                                            <Setter Property="Foreground" Value="{DynamicResource DangerBrush}" />
                                                                            <Style.Triggers>
                                                                                <DataTrigger Binding="{Binding PlacementTarget.DataContext.InBlocked, RelativeSource={RelativeSource AncestorType=ContextMenu}}" Value="True">
                                                                                    <Setter Property="Background" Value="{DynamicResource SuccessSoftBrush}" />
                                                                                    <Setter Property="BorderBrush" Value="{DynamicResource SuccessSoftBorderBrush}" />
                                                                                    <Setter Property="Foreground" Value="{DynamicResource DownloadBrush}" />
                                                                                </DataTrigger>
                                                                            </Style.Triggers>
                                                                        </Style>
                                                                    </MenuItem.Style>
                                                                    <MenuItem.Header>
                                                                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                                                            <TextBlock FontFamily="{StaticResource GlyphFont}" FontSize="9" Margin="0,0,6,0" VerticalAlignment="Center">
                                                                                <TextBlock.Style>
                                                                                    <Style TargetType="TextBlock">
                                                                                        <Setter Property="Text" Value="&#xE711;" />
                                                                                        <Style.Triggers>
                                                                                            <DataTrigger Binding="{Binding PlacementTarget.DataContext.InBlocked, RelativeSource={RelativeSource AncestorType=ContextMenu}}" Value="True">
                                                                                                <Setter Property="Text" Value="&#xE73E;" />
                                                                                            </DataTrigger>
                                                                                        </Style.Triggers>
                                                                                    </Style>
                                                                                </TextBlock.Style>
                                                                            </TextBlock>
                                                                            <TextBlock FontSize="10.5" FontWeight="SemiBold" VerticalAlignment="Center">
                                                                                <TextBlock.Style>
                                                                                    <Style TargetType="TextBlock">
                                                                                        <Setter Property="Text" Value="Block" />
                                                                                        <Style.Triggers>
                                                                                            <DataTrigger Binding="{Binding PlacementTarget.DataContext.InBlocked, RelativeSource={RelativeSource AncestorType=ContextMenu}}" Value="True">
                                                                                                <Setter Property="Text" Value="Allow" />
                                                                                            </DataTrigger>
                                                                                        </Style.Triggers>
                                                                                    </Style>
                                                                                </TextBlock.Style>
                                                                            </TextBlock>
                                                                        </StackPanel>
                                                                    </MenuItem.Header>
                                                                </MenuItem>
                                                            </ContextMenu>
                                                        </Button.ContextMenu>
                                                        <Button.Style>
                                                            <Style TargetType="Button" BasedOn="{StaticResource PillButton}">
                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{Binding InBlocked}" Value="False">
                                                                        <Setter Property="Background" Value="{DynamicResource SuccessSoftBrush}" />
                                                                        <Setter Property="BorderBrush" Value="{DynamicResource SuccessSoftBorderBrush}" />
                                                                        <Setter Property="Foreground" Value="{DynamicResource DownloadBrush}" />
                                                                    </DataTrigger>
                                                                    <DataTrigger Binding="{Binding InBlocked}" Value="True">
                                                                        <Setter Property="Background" Value="{DynamicResource DangerSoftBrush}" />
                                                                        <Setter Property="BorderBrush" Value="{DynamicResource DangerSoftBorderBrush}" />
                                                                        <Setter Property="Foreground" Value="{DynamicResource DangerBrush}" />
                                                                    </DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </Button.Style>
                                                        <StackPanel Orientation="Horizontal">
                                                            <TextBlock Text="{Binding InStateText}" FontSize="10" FontWeight="SemiBold" VerticalAlignment="Center" />
                                                            <TextBlock Text="&#xE73E;" FontFamily="{StaticResource GlyphFont}" FontSize="9" Margin="4,0,0,0" VerticalAlignment="Center">
                                                                <TextBlock.Style>
                                                                    <Style TargetType="TextBlock">
                                                                        <Setter Property="Visibility" Value="Hidden" />
                                                                        <Style.Triggers>
                                                                            <DataTrigger Binding="{Binding InBlocked}" Value="False">
                                                                                <Setter Property="Visibility" Value="Visible" />
                                                                            </DataTrigger>
                                                                        </Style.Triggers>
                                                                    </Style>
                                                                </TextBlock.Style>
                                                            </TextBlock>
                                                            <TextBlock Text="&#xE70D;"
                                                                       FontFamily="{StaticResource GlyphFont}"
                                                                       FontSize="7"
                                                                       Margin="4,0,0,0"
                                                                       VerticalAlignment="Center"
                                                                       Foreground="{DynamicResource TextMutedBrush}" />
                                                        </StackPanel>
                                                    </Button>

                                                    <Button Grid.Column="4"
                                                            VerticalAlignment="Center"
                                                            HorizontalAlignment="Center"
                                                            Click="OpenPillMenu"
                                                            Tag="{Binding DataContext, RelativeSource={RelativeSource AncestorType=Window}}"
                                                            IsEnabled="{Binding DataContext.IsFirewallEnabled, RelativeSource={RelativeSource AncestorType=Window}}"
                                                            AutomationProperties.Name="Upload access"
                                                            ToolTip="Change upload (outbound) access">
                                                        <Button.ContextMenu>
                                                            <ContextMenu Style="{StaticResource AccessMenu}">
                                                                <MenuItem Command="{Binding PlacementTarget.Tag.ToggleUploadCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                                                          CommandParameter="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource AncestorType=ContextMenu}}">
                                                                    <MenuItem.Style>
                                                                        <Style TargetType="MenuItem" BasedOn="{StaticResource AccessMenuItem}">
                                                                            <Setter Property="Background" Value="{DynamicResource DangerSoftBrush}" />
                                                                            <Setter Property="BorderBrush" Value="{DynamicResource DangerSoftBorderBrush}" />
                                                                            <Setter Property="Foreground" Value="{DynamicResource DangerBrush}" />
                                                                            <Style.Triggers>
                                                                                <DataTrigger Binding="{Binding PlacementTarget.DataContext.OutBlocked, RelativeSource={RelativeSource AncestorType=ContextMenu}}" Value="True">
                                                                                    <Setter Property="Background" Value="{DynamicResource SuccessSoftBrush}" />
                                                                                    <Setter Property="BorderBrush" Value="{DynamicResource SuccessSoftBorderBrush}" />
                                                                                    <Setter Property="Foreground" Value="{DynamicResource DownloadBrush}" />
                                                                                </DataTrigger>
                                                                            </Style.Triggers>
                                                                        </Style>
                                                                    </MenuItem.Style>
                                                                    <MenuItem.Header>
                                                                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                                                            <TextBlock FontFamily="{StaticResource GlyphFont}" FontSize="9" Margin="0,0,6,0" VerticalAlignment="Center">
                                                                                <TextBlock.Style>
                                                                                    <Style TargetType="TextBlock">
                                                                                        <Setter Property="Text" Value="&#xE711;" />
                                                                                        <Style.Triggers>
                                                                                            <DataTrigger Binding="{Binding PlacementTarget.DataContext.OutBlocked, RelativeSource={RelativeSource AncestorType=ContextMenu}}" Value="True">
                                                                                                <Setter Property="Text" Value="&#xE73E;" />
                                                                                            </DataTrigger>
                                                                                        </Style.Triggers>
                                                                                    </Style>
                                                                                </TextBlock.Style>
                                                                            </TextBlock>
                                                                            <TextBlock FontSize="10.5" FontWeight="SemiBold" VerticalAlignment="Center">
                                                                                <TextBlock.Style>
                                                                                    <Style TargetType="TextBlock">
                                                                                        <Setter Property="Text" Value="Block" />
                                                                                        <Style.Triggers>
                                                                                            <DataTrigger Binding="{Binding PlacementTarget.DataContext.OutBlocked, RelativeSource={RelativeSource AncestorType=ContextMenu}}" Value="True">
                                                                                                <Setter Property="Text" Value="Allow" />
                                                                                            </DataTrigger>
                                                                                        </Style.Triggers>
                                                                                    </Style>
                                                                                </TextBlock.Style>
                                                                            </TextBlock>
                                                                        </StackPanel>
                                                                    </MenuItem.Header>
                                                                </MenuItem>
                                                            </ContextMenu>
                                                        </Button.ContextMenu>
                                                        <Button.Style>
                                                            <Style TargetType="Button" BasedOn="{StaticResource PillButton}">
                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{Binding OutBlocked}" Value="False">
                                                                        <Setter Property="Background" Value="{DynamicResource SuccessSoftBrush}" />
                                                                        <Setter Property="BorderBrush" Value="{DynamicResource SuccessSoftBorderBrush}" />
                                                                        <Setter Property="Foreground" Value="{DynamicResource DownloadBrush}" />
                                                                    </DataTrigger>
                                                                    <DataTrigger Binding="{Binding OutBlocked}" Value="True">
                                                                        <Setter Property="Background" Value="{DynamicResource DangerSoftBrush}" />
                                                                        <Setter Property="BorderBrush" Value="{DynamicResource DangerSoftBorderBrush}" />
                                                                        <Setter Property="Foreground" Value="{DynamicResource DangerBrush}" />
                                                                    </DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </Button.Style>
                                                        <StackPanel Orientation="Horizontal">
                                                            <TextBlock Text="{Binding OutStateText}" FontSize="10" FontWeight="SemiBold" VerticalAlignment="Center" />
                                                            <TextBlock Text="&#xE73E;" FontFamily="{StaticResource GlyphFont}" FontSize="9" Margin="4,0,0,0" VerticalAlignment="Center">
                                                                <TextBlock.Style>
                                                                    <Style TargetType="TextBlock">
                                                                        <Setter Property="Visibility" Value="Hidden" />
                                                                        <Style.Triggers>
                                                                            <DataTrigger Binding="{Binding OutBlocked}" Value="False">
                                                                                <Setter Property="Visibility" Value="Visible" />
                                                                            </DataTrigger>
                                                                        </Style.Triggers>
                                                                    </Style>
                                                                </TextBlock.Style>
                                                            </TextBlock>
                                                            <TextBlock Text="&#xE70D;"
                                                                       FontFamily="{StaticResource GlyphFont}"
                                                                       FontSize="7"
                                                                       Margin="4,0,0,0"
                                                                       VerticalAlignment="Center"
                                                                       Foreground="{DynamicResource TextMutedBrush}" />
                                                        </StackPanel>
                                                    </Button>

                                                    <StackPanel Grid.Column="5" VerticalAlignment="Center" HorizontalAlignment="Right">
                                                        <StackPanel>
                                                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                                                <TextBlock Text="&#x2193;" FontSize="11" Foreground="{DynamicResource TextMutedBrush}" VerticalAlignment="Center" Margin="0,0,4,0" />
                                                                <Border Width="46" Height="4" Background="{DynamicResource TrackBrush}" CornerRadius="2" VerticalAlignment="Center" Margin="0,0,6,0" Visibility="{Binding ShowMeters, Converter={StaticResource BoolToVis}}">
                                                                    <Border Background="{DynamicResource DownloadBrush}" CornerRadius="2" RenderTransformOrigin="0,0.5">
                                                                        <Border.RenderTransform>
                                                                            <ScaleTransform ScaleX="{Binding DownloadScale}" />
                                                                        </Border.RenderTransform>
                                                                    </Border>
                                                                </Border>
                                                                <TextBlock Text="{Binding DownloadText}" FontSize="10.5" Width="60" TextAlignment="Right" VerticalAlignment="Center">
                                                                    <TextBlock.Style>
                                                                        <Style TargetType="TextBlock">
                                                                            <Setter Property="Foreground" Value="{DynamicResource DownloadBrush}" />
                                                                            <Style.Triggers>
                                                                                <DataTrigger Binding="{Binding DownloadIdle}" Value="True">
                                                                                    <Setter Property="Foreground" Value="{DynamicResource WarnBrush}" />
                                                                                </DataTrigger>
                                                                                <DataTrigger Binding="{Binding ShowMeters}" Value="False">
                                                                                    <Setter Property="Foreground" Value="{DynamicResource TextMutedBrush}" />
                                                                                </DataTrigger>
                                                                            </Style.Triggers>
                                                                        </Style>
                                                                    </TextBlock.Style>
                                                                </TextBlock>
                                                                <TextBlock Text="{Binding DownloadTotalText}" FontSize="10" Width="56" TextAlignment="Right" VerticalAlignment="Center" Foreground="{DynamicResource TextMutedBrush}" Margin="6,0,0,0" ToolTip="Downloaded since DoorNet started" />
                                                            </StackPanel>

                                                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,3,0,0">
                                                                <TextBlock Text="&#x2191;" FontSize="11" Foreground="{DynamicResource TextMutedBrush}" VerticalAlignment="Center" Margin="0,0,4,0" />
                                                                <Border Width="46" Height="4" Background="{DynamicResource TrackBrush}" CornerRadius="2" VerticalAlignment="Center" Margin="0,0,6,0" Visibility="{Binding ShowMeters, Converter={StaticResource BoolToVis}}">
                                                                    <Border Background="{DynamicResource UploadBrush}" CornerRadius="2" RenderTransformOrigin="0,0.5">
                                                                        <Border.RenderTransform>
                                                                            <ScaleTransform ScaleX="{Binding UploadScale}" />
                                                                        </Border.RenderTransform>
                                                                    </Border>
                                                                </Border>
                                                                <TextBlock Text="{Binding UploadText}" FontSize="10.5" Width="60" TextAlignment="Right" VerticalAlignment="Center">
                                                                    <TextBlock.Style>
                                                                        <Style TargetType="TextBlock">
                                                                            <Setter Property="Foreground" Value="{DynamicResource UploadBrush}" />
                                                                            <Style.Triggers>
                                                                                <DataTrigger Binding="{Binding UploadIdle}" Value="True">
                                                                                    <Setter Property="Foreground" Value="{DynamicResource WarnBrush}" />
                                                                                </DataTrigger>
                                                                                <DataTrigger Binding="{Binding ShowMeters}" Value="False">
                                                                                    <Setter Property="Foreground" Value="{DynamicResource TextMutedBrush}" />
                                                                                </DataTrigger>
                                                                            </Style.Triggers>
                                                                        </Style>
                                                                    </TextBlock.Style>
                                                                </TextBlock>
                                                                <TextBlock Text="{Binding UploadTotalText}" FontSize="10" Width="56" TextAlignment="Right" VerticalAlignment="Center" Foreground="{DynamicResource TextMutedBrush}" Margin="6,0,0,0" ToolTip="Uploaded since DoorNet started" />
                                                            </StackPanel>
                                                        </StackPanel>
                                                    </StackPanel>
                                                </Grid>

                                                <ItemsControl ItemsSource="{Binding Processes}"
                                                              Visibility="{Binding IsExpanded, Converter={StaticResource BoolToVis}}"
                                                              Margin="58,4,0,2">
                                                    <ItemsControl.ItemTemplate>
                                                        <DataTemplate>
                                                            <Grid Margin="0,2">
                                                                <Grid.ColumnDefinitions>
                                                                    <ColumnDefinition Width="*" />
                                                                    <ColumnDefinition Width="92" />
                                                                    <ColumnDefinition Width="92" />
                                                                    <ColumnDefinition Width="196" />
                                                                </Grid.ColumnDefinitions>

                                                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                                    <Image Source="{Binding Icon}" Width="16" Height="16" Margin="0,0,7,0" VerticalAlignment="Center" RenderOptions.BitmapScalingMode="HighQuality" />
                                                                    <TextBlock Text="{Binding Name}" FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                                                                    <TextBlock Text="{Binding PidText}" FontSize="10" Foreground="{DynamicResource TextMutedBrush}" Margin="8,0,0,0" VerticalAlignment="Center" />
                                                                </StackPanel>

                                                                <TextBlock Grid.Column="1" Text="{Binding DownloadText}" FontSize="10" TextAlignment="Right" Foreground="{DynamicResource DownloadBrush}" VerticalAlignment="Center" />
                                                                <TextBlock Grid.Column="2" Text="{Binding UploadText}" FontSize="10" TextAlignment="Right" Foreground="{DynamicResource UploadBrush}" VerticalAlignment="Center" />
                                                                <TextBlock Grid.Column="3" Text="{Binding TotalText}" FontSize="10" TextAlignment="Right" Foreground="{DynamicResource TextMutedBrush}" VerticalAlignment="Center" />
                                                            </Grid>
                                                        </DataTemplate>
                                                    </ItemsControl.ItemTemplate>
                                                </ItemsControl>

                                                <StackPanel Visibility="{Binding ShowTabsSection, Converter={StaticResource BoolToVis}}"
                                                            Margin="58,5,0,2">
                                                    <Button Command="{Binding DataContext.ToggleTabsCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                            CommandParameter="{Binding}"
                                                            HorizontalAlignment="Left"
                                                            AutomationProperties.Name="Toggle tabs"
                                                            Style="{StaticResource TabsToggleButton}">
                                                        <StackPanel Orientation="Horizontal">
                                                            <TextBlock FontFamily="{StaticResource GlyphFont}"
                                                                       FontSize="9"
                                                                       Margin="0,0,6,0"
                                                                       VerticalAlignment="Center">
                                                                <TextBlock.Style>
                                                                    <Style TargetType="TextBlock">
                                                                        <Setter Property="Text" Value="&#xE76C;" />
                                                                        <Setter Property="Foreground" Value="{DynamicResource TextMutedBrush}" />
                                                                        <Style.Triggers>
                                                                            <DataTrigger Binding="{Binding TabsExpanded}" Value="True">
                                                                                <Setter Property="Text" Value="&#xE70D;" />
                                                                            </DataTrigger>
                                                                        </Style.Triggers>
                                                                    </Style>
                                                                </TextBlock.Style>
                                                            </TextBlock>
                                                            <TextBlock Text="{Binding TabsHeader}"
                                                                       FontSize="9.5"
                                                                       FontWeight="SemiBold"
                                                                       Foreground="{DynamicResource TextMutedBrush}"
                                                                       VerticalAlignment="Center" />
                                                        </StackPanel>
                                                    </Button>

                                                    <StackPanel Visibility="{Binding TabsExpanded, Converter={StaticResource BoolToVis}}"
                                                                Margin="0,3,0,0">
                                                        <ItemsControl ItemsSource="{Binding VisibleTabs}">
                                                            <ItemsControl.ItemTemplate>
                                                                <DataTemplate>
                                                                    <StackPanel Orientation="Horizontal" Margin="0,1">
                                                                        <TextBlock Text="&#xE774;"
                                                                                   FontFamily="{StaticResource GlyphFont}"
                                                                                   FontSize="9"
                                                                                   Foreground="{DynamicResource TextMutedBrush}"
                                                                                   Margin="0,0,6,0"
                                                                                   VerticalAlignment="Center" />
                                                                        <TextBlock Text="{Binding}"
                                                                                   FontSize="10.5"
                                                                                   Foreground="{DynamicResource TextSecondaryBrush}"
                                                                                   TextTrimming="CharacterEllipsis"
                                                                                   VerticalAlignment="Center" />
                                                                    </StackPanel>
                                                                </DataTemplate>
                                                            </ItemsControl.ItemTemplate>
                                                        </ItemsControl>

                                                        <Grid Margin="0,4,0,0" Visibility="{Binding HasTabPages, Converter={StaticResource BoolToVis}}">
                                                            <Grid.ColumnDefinitions>
                                                                <ColumnDefinition Width="Auto" />
                                                                <ColumnDefinition Width="*" />
                                                                <ColumnDefinition Width="Auto" />
                                                            </Grid.ColumnDefinitions>

                                                            <Button Grid.Column="0"
                                                                    Content="Prev"
                                                                    Style="{StaticResource GhostButton}"
                                                                    FontSize="10"
                                                                    Padding="8,3"
                                                                    Command="{Binding DataContext.PreviousTabsCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                                    CommandParameter="{Binding}"
                                                                    IsEnabled="{Binding HasPreviousTabs}" />

                                                            <TextBlock Grid.Column="1"
                                                                       Text="{Binding TabsPageText}"
                                                                       FontSize="10"
                                                                       Foreground="{DynamicResource TextMutedBrush}"
                                                                       HorizontalAlignment="Center"
                                                                       VerticalAlignment="Center" />

                                                            <Button Grid.Column="2"
                                                                    Content="Next"
                                                                    Style="{StaticResource GhostButton}"
                                                                    FontSize="10"
                                                                    Padding="8,3"
                                                                    Command="{Binding DataContext.NextTabsCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                                    CommandParameter="{Binding}"
                                                                    IsEnabled="{Binding HasNextTabs}" />
                                                        </Grid>
                                                    </StackPanel>
                                                </StackPanel>
                                                </StackPanel>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </ScrollViewer>

                            <TextBlock Text="Waiting for connection data..."
                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Center">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock" BasedOn="{StaticResource Caption}">
                                        <Setter Property="Visibility" Value="Hidden" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding Apps.Count}" Value="0">
                                                <Setter Property="Visibility" Value="Visible" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                        </Grid>

                        <TextBlock Grid.Row="3"
                                   Text="{Binding PerAppNote}"
                                   Style="{StaticResource Caption}"
                                   FontSize="10"
                                   TextWrapping="Wrap"
                                   Margin="0,8,0,0" />
                    </Grid>
                </Border>

                <Border Grid.Column="1" Style="{StaticResource Card}" Margin="7,0,0,0" Padding="16,13,10,10">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>

                        <Grid Margin="0,0,6,0">
                            <TextBlock Text="Live connections" Style="{StaticResource SectionTitle}" />
                            <TextBlock HorizontalAlignment="Right" VerticalAlignment="Center" Style="{StaticResource Caption}">
                                <Run Text="{Binding ConnectionCount, Mode=OneWay}" />
                                <Run Text=" sockets" />
                            </TextBlock>
                        </Grid>

                        <Border Grid.Row="1" Margin="0,10,9,0" Padding="0,0,0,6"
                                BorderBrush="{DynamicResource LineSoftBrush}" BorderThickness="0,0,0,1">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="1.8*" />
                                    <ColumnDefinition Width="74" />
                                    <ColumnDefinition Width="1.05*" />
                                    <ColumnDefinition Width="1.15*" />
                                    <ColumnDefinition Width="104" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="APPLICATION" Style="{StaticResource TableHeader}" />
                                <TextBlock Grid.Column="1" Text="PROTOCOL" Style="{StaticResource TableHeader}" Margin="0,0,12,0" />
                                <TextBlock Grid.Column="2" Text="LOCAL" Style="{StaticResource TableHeader}" Margin="0,0,12,0" />
                                <TextBlock Grid.Column="3" Text="REMOTE" Style="{StaticResource TableHeader}" Margin="0,0,12,0" />
                                <TextBlock Grid.Column="4" Text="STATE" Style="{StaticResource TableHeader}" />
                            </Grid>
                        </Border>

                        <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto" Margin="0,6,0,0">
                            <ItemsControl ItemsSource="{Binding Connections}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <StackPanel>
                                            <Border Padding="0,7"
                                                    BorderBrush="{DynamicResource LineSoftBrush}"
                                                    BorderThickness="0,0,0,1"
                                                    ToolTip="{Binding Tooltip}">
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="1.8*" />
                                                        <ColumnDefinition Width="74" />
                                                        <ColumnDefinition Width="1.05*" />
                                                        <ColumnDefinition Width="1.15*" />
                                                        <ColumnDefinition Width="104" />
                                                    </Grid.ColumnDefinitions>

                                                    <Grid Grid.Column="0">
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="20" />
                                                            <ColumnDefinition Width="26" />
                                                            <ColumnDefinition Width="*" />
                                                        </Grid.ColumnDefinitions>

                                                        <Button Grid.Column="0"
                                                                Command="{Binding DataContext.ToggleExpandCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                                CommandParameter="{Binding}"
                                                                VerticalAlignment="Center"
                                                                ToolTip="Show or hide this application's connections">
                                                            <Button.Style>
                                                                <Style TargetType="Button" BasedOn="{StaticResource ExpandButton}">
                                                                    <Setter Property="Content" Value="&#xE76C;" />
                                                                    <Style.Triggers>
                                                                        <DataTrigger Binding="{Binding IsExpanded}" Value="True">
                                                                            <Setter Property="Content" Value="&#xE70D;" />
                                                                        </DataTrigger>
                                                                    </Style.Triggers>
                                                                </Style>
                                                            </Button.Style>
                                                        </Button>

                                                        <Image Grid.Column="1" Source="{Binding Icon}" Width="20" Height="20" VerticalAlignment="Center" RenderOptions.BitmapScalingMode="HighQuality" />

                                                        <StackPanel Grid.Column="2" Margin="8,0,0,0" VerticalAlignment="Center">
                                                            <TextBlock Text="{Binding Name}" FontSize="12.5" Foreground="{DynamicResource TextPrimaryBrush}" TextTrimming="CharacterEllipsis" />
                                                            <TextBlock Text="{Binding Summary}" Style="{StaticResource Caption}" Margin="0,2,0,0" TextTrimming="CharacterEllipsis" />
                                                        </StackPanel>
                                                    </Grid>

                                                    <TextBox Grid.Column="1" Text="{Binding ProtocolSummary, Mode=OneWay}" Style="{StaticResource SelectableSecondary}" FontSize="10.5" Margin="0,0,12,0" />
                                                    <TextBox Grid.Column="2" Text="{Binding LocalSummary, Mode=OneWay}" Style="{StaticResource SelectableSecondary}" FontSize="10.5" Margin="0,0,12,0" />
                                                    <TextBox Grid.Column="3" Text="{Binding RemoteSummary, Mode=OneWay}" Style="{StaticResource SelectableSecondary}" FontSize="10.5" Margin="0,0,12,0" />
                                                    <StackPanel Grid.Column="4" Orientation="Horizontal" VerticalAlignment="Center">
                                                        <Ellipse Width="5" Height="5" Fill="{Binding StateBrush}" Margin="0,0,5,0" VerticalAlignment="Center" />
                                                        <TextBlock Text="{Binding StateSummary}" FontSize="10" Foreground="{DynamicResource TextMutedBrush}" VerticalAlignment="Center" />
                                                    </StackPanel>
                                                </Grid>
                                            </Border>

                                            <ItemsControl ItemsSource="{Binding Connections}"
                                                          Visibility="{Binding IsExpanded, Converter={StaticResource BoolToVis}}"
                                                          Margin="0,2,0,4">
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate>
                                                        <Grid Margin="0,2">
                                                            <Grid.ColumnDefinitions>
                                                                <ColumnDefinition Width="1.8*" />
                                                                <ColumnDefinition Width="74" />
                                                                <ColumnDefinition Width="1.05*" />
                                                                <ColumnDefinition Width="1.15*" />
                                                                <ColumnDefinition Width="104" />
                                                            </Grid.ColumnDefinitions>

                                                            <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center" Margin="40,0,8,0">
                                                                <Image Source="{Binding Icon}"
                                                                       Width="14"
                                                                       Height="14"
                                                                       Margin="0,0,7,0"
                                                                       VerticalAlignment="Center"
                                                                       Opacity="0.9"
                                                                       RenderOptions.BitmapScalingMode="HighQuality" />
                                                                <TextBlock Text="{Binding ProcessName}"
                                                                           FontSize="10.5"
                                                                           Foreground="{DynamicResource TextSecondaryBrush}"
                                                                           TextTrimming="CharacterEllipsis"
                                                                           VerticalAlignment="Center" />
                                                            </StackPanel>

                                                            <TextBox Grid.Column="1" Text="{Binding Protocol, Mode=OneWay}" Style="{StaticResource SelectableCaption}" FontSize="10.5" Margin="0,0,12,0" />
                                                            <TextBox Grid.Column="2" Text="{Binding Local, Mode=OneWay}" Style="{StaticResource SelectableSecondary}" FontSize="10.5" Margin="0,0,12,0" />
                                                            <TextBox Grid.Column="3" Text="{Binding Remote, Mode=OneWay}" Style="{StaticResource SelectableSecondary}" FontSize="10.5" Margin="0,0,12,0" />

                                                            <StackPanel Grid.Column="4" Orientation="Horizontal" VerticalAlignment="Center">
                                                                <Ellipse Width="5" Height="5" Fill="{Binding StateBrush}" VerticalAlignment="Center" Margin="0,0,5,0" />
                                                                <TextBlock Text="{Binding State}" FontSize="10" Foreground="{DynamicResource TextMutedBrush}" VerticalAlignment="Center" />
                                                            </StackPanel>
                                                        </Grid>
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                        </StackPanel>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>
                    </Grid>
                </Border>
            </Grid>
        </Grid>

            <Grid Margin="20,16,20,14"
                  Visibility="{Binding IsChecked, ElementName=ScannerTab, Converter={StaticResource BoolToVis}}">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <StackPanel>
                    <TextBlock Text="Scanner" Style="{StaticResource SectionTitle}" FontSize="17" />

                    <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
                        <RadioButton x:Name="ScanDevicesSection"
                                     GroupName="ScannerSections"
                                     IsChecked="True"
                                     Style="{StaticResource SectionTab}"
                                     Content="Devices" />
                        <RadioButton x:Name="ScanPortsSection"
                                     GroupName="ScannerSections"
                                     Style="{StaticResource SectionTab}"
                                     Content="Port scan" />
                    </StackPanel>
                </StackPanel>

                <!-- Devices on this network -->
                <Grid Grid.Row="1"
                      Margin="0,12,0,0"
                      Visibility="{Binding IsChecked, ElementName=ScanDevicesSection, Converter={StaticResource BoolToVis}}">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <Grid>
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <Border Background="{DynamicResource SubtlePillBrush}"
                                    CornerRadius="5"
                                    Padding="6,2"
                                    VerticalAlignment="Center"
                                    Visibility="{Binding HasScanResults, Converter={StaticResource BoolToVis}}">
                                <TextBlock Text="{Binding ScannerSummaryText}"
                                           FontSize="10"
                                           Foreground="{DynamicResource TextMutedBrush}" />
                            </Border>
                            <TextBlock Style="{StaticResource Caption}" Margin="10,0,0,0" VerticalAlignment="Center">
                                <Run Text="Local network" />
                                <Run Text="{Binding ScannerSubnetText, Mode=OneWay}" />
                                <Run Text=" · " />
                                <Run Text="{Binding ScannerStatusText, Mode=OneWay}" />
                            </TextBlock>
                        </StackPanel>

                        <Button Content="{Binding ScanButtonText}"
                                Command="{Binding ScanNetworkCommand}"
                                IsEnabled="{Binding ScanButtonEnabled}"
                                Style="{StaticResource GhostButton}"
                                HorizontalAlignment="Right"
                                VerticalAlignment="Center" />
                    </Grid>

                    <!-- This machine's own connection -->
                    <Border Grid.Row="1" Style="{StaticResource Card}" Padding="14,11" Margin="0,10,9,0">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="1.15*" />
                                <ColumnDefinition Width="1*" />
                                <ColumnDefinition Width="1.15*" />
                                <ColumnDefinition Width="1.35*" />
                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Column="0" Margin="0,0,14,0">
                                <TextBlock Text="NETWORK" Style="{StaticResource TileLabel}" FontSize="9.5" />
                                <TextBox Text="{Binding LocalNetworkName, Mode=OneWay}"
                                         Style="{StaticResource SelectableText}"
                                         FontSize="12"
                                         FontWeight="SemiBold"
                                         Margin="0,3,0,0" />
                                <TextBox Text="{Binding LocalNetworkDetail, Mode=OneWay}"
                                         Style="{StaticResource SelectableCaption}"
                                         FontSize="10"
                                         Margin="0,2,0,0" />
                            </StackPanel>

                            <StackPanel Grid.Column="1" Margin="0,0,14,0">
                                <TextBlock Text="ROUTER" Style="{StaticResource TileLabel}" FontSize="9.5" />
                                <TextBox Text="{Binding LocalRouterText, Mode=OneWay}"
                                         Style="{StaticResource SelectableText}"
                                         FontSize="12"
                                         FontWeight="SemiBold"
                                         Margin="0,3,0,0" />
                                <TextBox Text="{Binding LocalRouterDetail, Mode=OneWay}"
                                         Style="{StaticResource SelectableCaption}"
                                         FontSize="10"
                                         Margin="0,2,0,0" />
                            </StackPanel>

                            <StackPanel Grid.Column="2" Margin="0,0,14,0">
                                <TextBlock Text="PUBLIC IP" Style="{StaticResource TileLabel}" FontSize="9.5" />
                                <TextBox Text="{Binding LocalPublicIpText, Mode=OneWay}"
                                         Style="{StaticResource SelectableText}"
                                         FontSize="12"
                                         FontWeight="SemiBold"
                                         Margin="0,3,0,0" />
                                <TextBox Text="{Binding LocalIspText, Mode=OneWay}"
                                         Style="{StaticResource SelectableCaption}"
                                         FontSize="10"
                                         Margin="0,2,0,0" />
                            </StackPanel>

                            <StackPanel Grid.Column="3">
                                <TextBlock Text="THIS DEVICE" Style="{StaticResource TileLabel}" FontSize="9.5" />
                                <TextBox Text="{Binding LocalHostText, Mode=OneWay}"
                                         Style="{StaticResource SelectableText}"
                                         FontSize="12"
                                         FontWeight="SemiBold"
                                         Margin="0,3,0,0" />
                                <TextBox Text="{Binding LocalHostDetail, Mode=OneWay}"
                                         Style="{StaticResource SelectableCaption}"
                                         FontSize="10"
                                         Margin="0,2,0,0" />
                            </StackPanel>
                        </Grid>
                    </Border>

                    <Border Grid.Row="2"
                            Margin="0,12,9,0"
                            Padding="0,0,0,6"
                            BorderBrush="{DynamicResource LineSoftBrush}"
                            BorderThickness="0,0,0,1">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="116" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="112" />
                                <ColumnDefinition Width="132" />
                                <ColumnDefinition Width="100" />
                                <ColumnDefinition Width="180" />
                                <ColumnDefinition Width="112" />
                                <ColumnDefinition Width="86" />
                                <ColumnDefinition Width="84" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="TYPE" Style="{StaticResource TableHeader}" />
                            <TextBlock Grid.Column="1" Text="NAME" Style="{StaticResource TableHeader}" Margin="0,0,10,0" />
                            <TextBlock Grid.Column="2" Text="IP" Style="{StaticResource TableHeader}" Margin="0,0,10,0" />
                            <TextBlock Grid.Column="3" Text="MAC" Style="{StaticResource TableHeader}" Margin="0,0,10,0" />
                            <TextBlock Grid.Column="4" Text="SYSTEM" Style="{StaticResource TableHeader}" Margin="0,0,10,0" />
                            <TextBlock Grid.Column="5" Text="VENDOR" Style="{StaticResource TableHeader}" Margin="0,0,10,0" />
                            <TextBlock Grid.Column="6" Text="PORTS" Style="{StaticResource TableHeader}" Margin="0,0,10,0" />
                            <TextBlock Grid.Column="7" Text="LATENCY" Style="{StaticResource TableHeader}" Margin="0,0,10,0" />
                            <TextBlock Grid.Column="8" Text="STATE" Style="{StaticResource TableHeader}" />
                        </Grid>
                    </Border>

                    <Grid Grid.Row="3">
                        <ScrollViewer VerticalScrollBarVisibility="Auto">
                            <ItemsControl ItemsSource="{Binding ScanDevices}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Padding="0,8"
                                                BorderBrush="{DynamicResource LineSoftBrush}"
                                                BorderThickness="0,0,0,1"
                                                ToolTip="{Binding Tooltip}">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="116" />
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="112" />
                                                    <ColumnDefinition Width="132" />
                                                    <ColumnDefinition Width="100" />
                                                    <ColumnDefinition Width="180" />
                                                    <ColumnDefinition Width="112" />
                                                    <ColumnDefinition Width="86" />
                                                    <ColumnDefinition Width="84" />
                                                </Grid.ColumnDefinitions>

                                                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                                                    <TextBlock Text="{Binding Glyph}"
                                                               FontFamily="{StaticResource GlyphFont}"
                                                               FontSize="13"
                                                               Margin="2,0,8,0"
                                                               VerticalAlignment="Center"
                                                               Foreground="{DynamicResource TextSecondaryBrush}" />
                                                    <TextBlock Text="{Binding Kind}"
                                                               FontSize="11.5"
                                                               Foreground="{DynamicResource TextSecondaryBrush}"
                                                               VerticalAlignment="Center" />
                                                </StackPanel>

                                                <TextBlock Grid.Column="1"
                                                           Text="{Binding Name}"
                                                           FontSize="12"
                                                           Foreground="{DynamicResource TextPrimaryBrush}"
                                                           TextTrimming="CharacterEllipsis"
                                                           VerticalAlignment="Center"
                                                           Margin="0,0,10,0" />

                                                <TextBox Grid.Column="2"
                                                         Text="{Binding Ip, Mode=OneWay}"
                                                         Style="{StaticResource SelectableSecondary}"
                                                         FontSize="11"
                                                         Margin="0,0,10,0" />

                                                <TextBox Grid.Column="3"
                                                         Text="{Binding Mac, Mode=OneWay}"
                                                         Style="{StaticResource SelectableCaption}"
                                                         FontSize="10.5"
                                                         Margin="0,0,10,0" />

                                                <TextBlock Grid.Column="4"
                                                           Text="{Binding System}"
                                                           FontSize="11"
                                                           Foreground="{DynamicResource TextSecondaryBrush}"
                                                           TextTrimming="CharacterEllipsis"
                                                           VerticalAlignment="Center"
                                                           Margin="0,0,10,0" />

                                                <TextBlock Grid.Column="5"
                                                           Text="{Binding Vendor}"
                                                           FontSize="11"
                                                           Foreground="{DynamicResource TextSecondaryBrush}"
                                                           TextTrimming="CharacterEllipsis"
                                                           VerticalAlignment="Center"
                                                           Margin="0,0,10,0" />

                                                <TextBox Grid.Column="6"
                                                         Text="{Binding Ports, Mode=OneWay}"
                                                         Style="{StaticResource SelectableCaption}"
                                                         FontSize="10.5"
                                                         Margin="0,0,10,0" />

                                                <TextBlock Grid.Column="7"
                                                           Text="{Binding Latency}"
                                                           FontSize="10.5"
                                                           Foreground="{DynamicResource TextMutedBrush}"
                                                           VerticalAlignment="Center"
                                                           Margin="0,0,10,0" />

                                                <StackPanel Grid.Column="8" Orientation="Horizontal" VerticalAlignment="Center">
                                                    <Ellipse Width="5" Height="5" Fill="{Binding StateBrush}" Margin="0,0,6,0" VerticalAlignment="Center" />
                                                    <TextBlock Text="{Binding StateText}"
                                                               FontSize="10.5"
                                                               Foreground="{DynamicResource TextMutedBrush}"
                                                               VerticalAlignment="Center" />
                                                </StackPanel>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>

                        <Border>
                            <Border.Style>
                                <Style TargetType="Border" BasedOn="{StaticResource Card}">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding HasScanResults}" Value="True">
                                            <Setter Property="Visibility" Value="Collapsed" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Border.Style>
                            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                                <TextBlock Text="&#xE721;"
                                           FontFamily="{StaticResource GlyphFont}"
                                           FontSize="30"
                                           HorizontalAlignment="Center"
                                           Foreground="{DynamicResource TextMutedBrush}" />
                                <TextBlock Text="No scan yet"
                                           FontSize="13"
                                           FontWeight="SemiBold"
                                           HorizontalAlignment="Center"
                                           Foreground="{DynamicResource TextPrimaryBrush}"
                                           Margin="0,12,0,0" />
                                <TextBlock Text="Run a scan to list this network's devices, addresses and open ports."
                                           Style="{StaticResource Caption}"
                                           HorizontalAlignment="Center"
                                           Margin="0,4,0,0" />
                            </StackPanel>
                        </Border>
                    </Grid>
                </Grid>

                <!-- Port scan section (next scanner type) -->
                <Border Grid.Row="1"
                        Margin="0,12,0,0"
                        Visibility="{Binding IsChecked, ElementName=ScanPortsSection, Converter={StaticResource BoolToVis}}">
                    <Border.Style>
                        <Style TargetType="Border" BasedOn="{StaticResource Card}">
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsChecked, ElementName=ScanDevicesSection}" Value="True">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Border.Style>
                    <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                        <TextBlock Text="&#xE968;"
                                   FontFamily="{StaticResource GlyphFont}"
                                   FontSize="30"
                                   HorizontalAlignment="Center"
                                   Foreground="{DynamicResource TextMutedBrush}" />
                        <TextBlock Text="Port scanning is next"
                                   FontSize="13"
                                   FontWeight="SemiBold"
                                   HorizontalAlignment="Center"
                                   Foreground="{DynamicResource TextPrimaryBrush}"
                                   Margin="0,12,0,0" />
                        <TextBlock Text="Targeted host and service scans will live in this section."
                                   Style="{StaticResource Caption}"
                                   HorizontalAlignment="Center"
                                   Margin="0,4,0,0" />
                    </StackPanel>
                </Border>
            </Grid>

            <!-- Traffic: every socket, split by protocol, plus the ICMP counters -->
            <Grid Margin="20,16,20,14"
                  Visibility="{Binding IsChecked, ElementName=TrafficTab, Converter={StaticResource BoolToVis}}">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <Grid>
                    <StackPanel>
                        <TextBlock Text="Traffic" Style="{StaticResource SectionTitle}" FontSize="17" />
                        <TextBlock Text="{Binding TrafficSummary}"
                                   Style="{StaticResource Caption}"
                                   Margin="0,4,0,0" />
                    </StackPanel>

                    <Border Background="{DynamicResource SubtlePillBrush}"
                            CornerRadius="5"
                            Padding="8,2"
                            HorizontalAlignment="Right"
                            VerticalAlignment="Top"
                            ToolTip="The socket tables do not list ICMP, and per-peer pings need a packet driver. These are the machine-wide echo counters.">
                        <TextBlock Text="{Binding IcmpSummary}"
                                   FontSize="10"
                                   Foreground="{DynamicResource TextMutedBrush}" />
                    </Border>
                </Grid>

                <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,12,0,0">
                    <TextBlock Text="Protocol"
                               Style="{StaticResource Caption}"
                               VerticalAlignment="Center"
                               Margin="0,0,8,0" />
                    <Button Style="{StaticResource GhostButton}"
                            Padding="12,4"
                            FontSize="11"
                            Content="{Binding ProtocolFilterLabel}"
                            Tag="{Binding}"
                            Click="OpenFilterMenu">
                        <Button.ContextMenu>
                            <ContextMenu ItemsSource="{Binding PlacementTarget.DataContext.ProtocolFilters, RelativeSource={RelativeSource Self}}">
                                <ContextMenu.ItemContainerStyle>
                                    <Style TargetType="MenuItem" BasedOn="{StaticResource {x:Type MenuItem}}">
                                        <Setter Property="Header" Value="{Binding Display}" />
                                        <Setter Property="Command"
                                                Value="{Binding PlacementTarget.Tag.SelectProtocolFilterCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}" />
                                        <Setter Property="CommandParameter" Value="{Binding}" />
                                    </Style>
                                </ContextMenu.ItemContainerStyle>
                            </ContextMenu>
                        </Button.ContextMenu>
                    </Button>
                </StackPanel>

                <Border Grid.Row="2"
                        Margin="0,12,0,0"
                        Padding="0,0,0,6"
                        BorderBrush="{DynamicResource LineSoftBrush}"
                        BorderThickness="0,0,0,1">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="92" />
                            <ColumnDefinition Width="140" />
                            <ColumnDefinition Width="64" />
                            <ColumnDefinition Width="70" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="96" />
                            <ColumnDefinition Width="56" />
                            <ColumnDefinition Width="80" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="TAG" Style="{StaticResource TableHeader}" Margin="0,0,10,0" />
                        <TextBlock Grid.Column="1" Text="AGENT" Style="{StaticResource TableHeader}" Margin="0,0,10,0" />
                        <TextBlock Grid.Column="2" Text="DIR" Style="{StaticResource TableHeader}" Margin="0,0,10,0" />
                        <TextBlock Grid.Column="3" Text="PROTO" Style="{StaticResource TableHeader}" Margin="0,0,10,0" />
                        <TextBlock Grid.Column="4" Text="ENDPOINT" Style="{StaticResource TableHeader}" Margin="0,0,10,0" />
                        <TextBlock Grid.Column="5" Text="STATE" Style="{StaticResource TableHeader}" Margin="0,0,10,0" />
                        <TextBlock Grid.Column="6" Text="SCORE" Style="{StaticResource TableHeader}" Margin="0,0,10,0" />
                        <TextBlock Grid.Column="7" Text="SEEN" Style="{StaticResource TableHeader}" />
                    </Grid>
                </Border>

                <Border Grid.Row="3" Style="{StaticResource Card}" Margin="0,8,0,0" Padding="0">
                    <Grid>
                        <Grid.Resources>
                            <DataTemplate x:Key="TrafficRowTemplate">
                                <Border Padding="12,7"
                                        BorderBrush="{DynamicResource LineSoftBrush}"
                                        BorderThickness="0,0,0,1"
                                        ToolTip="{Binding Detail}">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="92" />
                                            <ColumnDefinition Width="140" />
                                            <ColumnDefinition Width="64" />
                                            <ColumnDefinition Width="70" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="96" />
                                            <ColumnDefinition Width="56" />
                                            <ColumnDefinition Width="80" />
                                        </Grid.ColumnDefinitions>

                                        <TextBlock Grid.Column="0"
                                                   Text="{Binding Tag}"
                                                   FontSize="10"
                                                   FontWeight="SemiBold"
                                                   Foreground="{Binding TagBrush}"
                                                   VerticalAlignment="Center"
                                                   Margin="0,0,10,0" />

                                        <TextBlock Grid.Column="1"
                                                   Text="{Binding Agent}"
                                                   FontSize="11.5"
                                                   Foreground="{DynamicResource TextPrimaryBrush}"
                                                   TextTrimming="CharacterEllipsis"
                                                   VerticalAlignment="Center"
                                                   Margin="0,0,10,0" />

                                        <TextBlock Grid.Column="2"
                                                   Text="{Binding Direction}"
                                                   FontSize="10.5"
                                                   Foreground="{DynamicResource TextSecondaryBrush}"
                                                   VerticalAlignment="Center"
                                                   Margin="0,0,10,0" />

                                        <TextBlock Grid.Column="3"
                                                   Text="{Binding Protocol}"
                                                   FontSize="10.5"
                                                   Foreground="{DynamicResource TextMutedBrush}"
                                                   VerticalAlignment="Center"
                                                   Margin="0,0,10,0" />

                                        <TextBlock Grid.Column="4"
                                                   Text="{Binding Endpoint}"
                                                   FontSize="10.5"
                                                   Foreground="{DynamicResource TextSecondaryBrush}"
                                                   TextTrimming="CharacterEllipsis"
                                                   VerticalAlignment="Center"
                                                   Margin="0,0,10,0" />

                                        <TextBlock Grid.Column="5"
                                                   Text="{Binding State}"
                                                   FontSize="10.5"
                                                   Foreground="{DynamicResource TextMutedBrush}"
                                                   VerticalAlignment="Center"
                                                   Margin="0,0,10,0" />

                                        <TextBlock Grid.Column="6"
                                                   Text="{Binding ScoreText}"
                                                   FontSize="11"
                                                   FontWeight="SemiBold"
                                                   Foreground="{Binding TagBrush}"
                                                   VerticalAlignment="Center"
                                                   Margin="0,0,10,0" />

                                        <TextBlock Grid.Column="7"
                                                   Text="{Binding SeenText}"
                                                   FontSize="10"
                                                   Foreground="{DynamicResource TextMutedBrush}"
                                                   VerticalAlignment="Center" />
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </Grid.Resources>

                        <ScrollViewer VerticalScrollBarVisibility="Auto">
                            <ItemsControl ItemsSource="{Binding Traffic}" ItemTemplate="{StaticResource TrafficRowTemplate}" />
                        </ScrollViewer>

                        <TextBlock Text="Collecting traffic…"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock" BasedOn="{StaticResource Caption}">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding HasTraffic}" Value="False">
                                            <Setter Property="Visibility" Value="Visible" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                    </Grid>
                </Border>
            </Grid>
            <!-- Alerts raised by the URL rules -->
            <Grid Margin="20,16,20,14"
                  Visibility="{Binding IsChecked, ElementName=AlertsTab, Converter={StaticResource BoolToVis}}">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <Grid>
                    <StackPanel>
                        <TextBlock Text="Alerts" Style="{StaticResource SectionTitle}" FontSize="17" />
                        <TextBlock Text="{Binding UrlAlertsSummary}"
                                   Style="{StaticResource Caption}"
                                   Margin="0,4,0,0" />
                    </StackPanel>

                    <Border Background="{DynamicResource SubtlePillBrush}"
                            CornerRadius="5"
                            Padding="7,2"
                            HorizontalAlignment="Right"
                            VerticalAlignment="Top">
                        <TextBlock Text="local heuristics · no reputation service"
                                   FontSize="10"
                                   Foreground="{DynamicResource TextMutedBrush}" />
                    </Border>
                </Grid>

                <Border Grid.Row="1" Style="{StaticResource Card}" Margin="0,14,0,0" Padding="0,0,0,6">
                    <Grid>
                        <ScrollViewer VerticalScrollBarVisibility="Auto">
                            <ItemsControl ItemsSource="{Binding UrlAlerts}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Padding="14,11"
                                                BorderBrush="{DynamicResource LineSoftBrush}"
                                                BorderThickness="0,0,0,1">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>

                                                <StackPanel Grid.Column="0" Margin="0,0,16,0">
                                                    <StackPanel Orientation="Horizontal">
                                                        <Ellipse Width="6"
                                                                 Height="6"
                                                                 Fill="{Binding SeverityBrush}"
                                                                 VerticalAlignment="Center"
                                                                 Margin="0,0,7,0" />
                                                        <TextBlock Text="{Binding Host}"
                                                                   FontSize="12.5"
                                                                   FontWeight="SemiBold"
                                                                   Foreground="{DynamicResource TextPrimaryBrush}"
                                                                   TextTrimming="CharacterEllipsis"
                                                                   VerticalAlignment="Center" />
                                                        <TextBlock Text="{Binding SeverityText}"
                                                                   FontSize="10"
                                                                   FontWeight="SemiBold"
                                                                   Foreground="{Binding SeverityBrush}"
                                                                   Margin="8,0,0,0"
                                                                   VerticalAlignment="Center" />
                                                        <TextBlock Text="{Binding ScoreText, StringFormat=score {0}}"
                                                                   FontSize="10"
                                                                   Foreground="{DynamicResource TextMutedBrush}"
                                                                   Margin="6,0,0,0"
                                                                   VerticalAlignment="Center" />
                                                        <TextBlock Text="{Binding Process}"
                                                                   FontSize="10"
                                                                   Foreground="{DynamicResource TextMutedBrush}"
                                                                   Margin="10,0,0,0"
                                                                   VerticalAlignment="Center" />
                                                        <TextBlock Text="{Binding ReputationText}"
                                                                   FontSize="10"
                                                                   FontWeight="SemiBold"
                                                                   Foreground="{DynamicResource TextSecondaryBrush}"
                                                                   ToolTip="{Binding ReputationDetail}"
                                                                   Margin="10,0,0,0"
                                                                   VerticalAlignment="Center" />
                                                    </StackPanel>

                                                    <TextBlock Text="{Binding Url}"
                                                               FontSize="10.5"
                                                               Foreground="{DynamicResource TextSecondaryBrush}"
                                                               TextTrimming="CharacterEllipsis"
                                                               Margin="13,4,0,0" />

                                                    <TextBlock Text="{Binding Reasons}"
                                                               Style="{StaticResource Caption}"
                                                               TextTrimming="CharacterEllipsis"
                                                               Margin="13,2,0,0" />

                                                    <TextBlock Text="{Binding SeenText}"
                                                               FontSize="10"
                                                               Foreground="{DynamicResource TextMutedBrush}"
                                                               Margin="13,3,0,0" />
                                                </StackPanel>

                                                <StackPanel Grid.Column="1"
                                                            Orientation="Horizontal"
                                                            VerticalAlignment="Center">
                                                    <Button Content="Copy"
                                                            Style="{StaticResource GhostButton}"
                                                            Padding="10,4"
                                                            FontSize="11"
                                                            Margin="0,0,6,0"
                                                            Command="{Binding DataContext.CopyAlertCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                            CommandParameter="{Binding}" />
                                                    <Button Content="Dismiss"
                                                            Style="{StaticResource GhostButton}"
                                                            Padding="10,4"
                                                            FontSize="11"
                                                            Margin="0,0,6,0"
                                                            Command="{Binding DataContext.DismissAlertCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                            CommandParameter="{Binding}" />
                                                    <Button Content="Whitelist"
                                                            Style="{StaticResource GhostButton}"
                                                            Padding="10,4"
                                                            FontSize="11"
                                                            Command="{Binding DataContext.WhitelistAlertCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                            CommandParameter="{Binding}" />
                                                </StackPanel>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>

                        <Border>
                            <Border.Style>
                                <Style TargetType="Border">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding HasUrlAlerts}" Value="True">
                                            <Setter Property="Visibility" Value="Collapsed" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Border.Style>
                            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                                <TextBlock Text="&#xE73E;"
                                           FontFamily="{StaticResource GlyphFont}"
                                           FontSize="26"
                                           HorizontalAlignment="Center"
                                           Foreground="{DynamicResource TextMutedBrush}" />
                                <TextBlock Text="No suspicious addresses"
                                           FontSize="13"
                                           FontWeight="SemiBold"
                                           HorizontalAlignment="Center"
                                           Foreground="{DynamicResource TextPrimaryBrush}"
                                           Margin="0,10,0,0" />
                                <TextBlock Text="Pages you open are scored locally. Anything above the threshold lands here with its reasons."
                                           Style="{StaticResource Caption}"
                                           HorizontalAlignment="Center"
                                           Margin="0,4,0,0" />
                            </StackPanel>
                        </Border>
                    </Grid>
                </Border>
            </Grid>

            <!-- Rules: how suspicious addresses are scored -->
            <Grid Margin="20,16,20,14"
                  Visibility="{Binding IsChecked, ElementName=RulesTab, Converter={StaticResource BoolToVis}}">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <StackPanel>
                    <TextBlock Text="Rules" Style="{StaticResource SectionTitle}" FontSize="17" />
                    <TextBlock Text="Every decision is made on this machine: no URL is sent anywhere."
                               Style="{StaticResource Caption}"
                               Margin="0,4,0,0" />

                    <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
                        <RadioButton x:Name="RuleDetectionsSection"
                                     GroupName="RuleSections"
                                     IsChecked="True"
                                     Style="{StaticResource SectionTab}"
                                     Content="Detections" />
                        <RadioButton x:Name="RuleSourcesSection"
                                     GroupName="RuleSections"
                                     Style="{StaticResource SectionTab}"
                                     Content="Sources" />
                        <RadioButton x:Name="RuleReputationSection"
                                     GroupName="RuleSections"
                                     Style="{StaticResource SectionTab}"
                                     Content="Reputation" />
                    </StackPanel>
                </StackPanel>


                <!-- Every detector and its weight -->
                <Border Grid.Row="1"
                        Margin="0,12,0,0"
                        Style="{StaticResource Card}"
                        Visibility="{Binding IsChecked, ElementName=RuleDetectionsSection, Converter={StaticResource BoolToVis}}">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>

                        <StackPanel>
                            <TextBlock Text="Detectors"
                                       Style="{StaticResource SectionTitle}" />
                            <TextBlock Text="A URL is reported to Alerts at 50 points. Strong single signals (credentials trick, brand lookalike, disguised executable) reach that on their own."
                                       Style="{StaticResource Caption}"
                                       Margin="0,4,0,0" />
                        </StackPanel>

                        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Margin="0,12,0,0">
                            <ItemsControl ItemsSource="{Binding DetectionRules}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Padding="0,8"
                                                BorderBrush="{DynamicResource LineSoftBrush}"
                                                BorderThickness="0,0,0,1">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="46" />
                                                    <ColumnDefinition Width="220" />
                                                    <ColumnDefinition Width="*" />
                                                </Grid.ColumnDefinitions>

                                                <TextBlock Grid.Column="0"
                                                           Text="{Binding WeightText}"
                                                           FontSize="11.5"
                                                           FontWeight="SemiBold"
                                                           Foreground="{DynamicResource TextSecondaryBrush}"
                                                           VerticalAlignment="Center" />
                                                <TextBlock Grid.Column="1"
                                                           Text="{Binding Title}"
                                                           FontSize="12"
                                                           Foreground="{DynamicResource TextPrimaryBrush}"
                                                           TextTrimming="CharacterEllipsis"
                                                           VerticalAlignment="Center"
                                                           Margin="0,0,12,0" />
                                                <TextBlock Grid.Column="2"
                                                           Text="{Binding Detail}"
                                                           FontSize="10.5"
                                                           Foreground="{DynamicResource TextMutedBrush}"
                                                           TextTrimming="CharacterEllipsis"
                                                           VerticalAlignment="Center" />
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>
                    </Grid>
                </Border>

                <!-- What the scanner can and cannot see -->
                <Border Grid.Row="1"
                        Margin="0,12,0,0"
                        Style="{StaticResource Card}"
                        Visibility="{Binding IsChecked, ElementName=RuleSourcesSection, Converter={StaticResource BoolToVis}}">
                    <StackPanel>
                        <TextBlock Text="Where addresses come from" Style="{StaticResource SectionTitle}" />

                        <TextBlock Text="Browser address bar (UI Automation)"
                                   FontSize="12"
                                   FontWeight="SemiBold"
                                   Foreground="{DynamicResource TextPrimaryBrush}"
                                   Margin="0,12,0,0" />
                        <TextBlock Text="The active tab of every open browser window, refreshed every few seconds. Titles and addresses only; no history files and nothing leaves the machine."
                                   Style="{StaticResource Caption}"
                                   TextWrapping="Wrap"
                                   Margin="0,3,0,0" />

                        <TextBlock Text="What is not covered yet"
                                   FontSize="12"
                                   FontWeight="SemiBold"
                                   Foreground="{DynamicResource TextPrimaryBrush}"
                                   Margin="0,14,0,0" />
                        <TextBlock Text="Every TCP and UDP socket — any port, any process — is listed in the Traffic tab. ICMP has no socket entry, so pings appear only as machine-wide echo counters. Connections shorter than half a second between samples, and traffic from another machine, need a packet driver to be captured."
                                   Style="{StaticResource Caption}"
                                   TextWrapping="Wrap"
                                   Margin="0,3,0,0" />

                        <TextBlock Text="Privacy"
                                   FontSize="12"
                                   FontWeight="SemiBold"
                                   Foreground="{DynamicResource TextPrimaryBrush}"
                                   Margin="0,14,0,0" />
                        <TextBlock Text="Scoring is local and offline. Whitelisted hosts are remembered in settings.json under %LocalAppData%\DoorNet."
                                   Style="{StaticResource Caption}"
                                   TextWrapping="Wrap"
                                   Margin="0,3,0,0" />
                    </StackPanel>
                </Border>

                <!-- Optional reputation lookups -->
                <Border Grid.Row="1"
                        Margin="0,12,0,0"
                        Style="{StaticResource Card}"
                        Visibility="{Binding IsChecked, ElementName=RuleReputationSection, Converter={StaticResource BoolToVis}}">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>

                        <StackPanel>
                            <TextBlock Text="Reputation (VirusTotal)"
                                       Style="{StaticResource SectionTitle}" />
                            <TextBlock Text="{Binding ReputationStatusText}"
                                       Style="{StaticResource Caption}"
                                       Margin="0,4,0,0" />
                            <TextBlock Text="Only hosts that already look suspicious are looked up — never full URLs, never private addresses. A verdict adds its own weight to the score (up to +60), results are cached for a day, and requests are spaced out to respect the free tier. Remove the key to stay fully offline."
                                       Style="{StaticResource Caption}"
                                       TextWrapping="Wrap"
                                       Margin="0,8,0,0" />

                            <TextBlock Text="Add or change the key in Settings → VirusTotal."
                                       Style="{StaticResource Caption}"
                                       FontSize="10"
                                       Margin="0,12,0,0" />
                        </StackPanel>

                        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Margin="0,12,0,0">
                            <ItemsControl ItemsSource="{Binding Reputations}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Padding="0,8"
                                                BorderBrush="{DynamicResource LineSoftBrush}"
                                                BorderThickness="0,0,0,1">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="220" />
                                                    <ColumnDefinition Width="150" />
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="86" />
                                                </Grid.ColumnDefinitions>

                                                <TextBlock Grid.Column="0"
                                                           Text="{Binding Target}"
                                                           FontSize="12"
                                                           Foreground="{DynamicResource TextPrimaryBrush}"
                                                           TextTrimming="CharacterEllipsis"
                                                           VerticalAlignment="Center"
                                                           Margin="0,0,12,0" />
                                                <TextBlock Grid.Column="1"
                                                           Text="{Binding Summary}"
                                                           FontSize="11"
                                                           FontWeight="SemiBold"
                                                           Foreground="{Binding SeverityBrush}"
                                                           VerticalAlignment="Center"
                                                           Margin="0,0,12,0" />
                                                <TextBlock Grid.Column="2"
                                                           Text="{Binding Detail}"
                                                           FontSize="10.5"
                                                           Foreground="{DynamicResource TextMutedBrush}"
                                                           TextTrimming="CharacterEllipsis"
                                                           VerticalAlignment="Center"
                                                           Margin="0,0,12,0" />
                                                <TextBlock Grid.Column="3"
                                                           Text="{Binding LookedUpText}"
                                                           FontSize="10"
                                                           Foreground="{DynamicResource TextMutedBrush}"
                                                           VerticalAlignment="Center" />
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>
                    </Grid>
                </Border>
            </Grid>

            <Grid Margin="20,16,20,14"
                  Visibility="{Binding IsChecked, ElementName=ActionsTab, Converter={StaticResource BoolToVis}}">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <StackPanel>
                        <TextBlock Text="Actions" Style="{StaticResource SectionTitle}" FontSize="17" />
                        <TextBlock Text="One-click controls and automations will be built here."
                                   Style="{StaticResource Caption}"
                                   Margin="0,4,0,0" />
                    </StackPanel>

                    <Border Grid.Row="1" Style="{StaticResource Card}" Margin="0,14,0,0">
                        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                            <TextBlock Text="&#xE945;"
                                       FontFamily="{StaticResource GlyphFont}"
                                       FontSize="30"
                                       HorizontalAlignment="Center"
                                       Foreground="{DynamicResource TextMutedBrush}" />
                            <TextBlock Text="Nothing here yet"
                                       FontSize="13"
                                       FontWeight="SemiBold"
                                       HorizontalAlignment="Center"
                                       Foreground="{DynamicResource TextPrimaryBrush}"
                                       Margin="0,12,0,0" />
                            <TextBlock Text="New actions will appear here as they are added."
                                       Style="{StaticResource Caption}"
                                       HorizontalAlignment="Center"
                                       Margin="0,4,0,0" />
                        </StackPanel>
                    </Border>
            </Grid>

            <!-- Settings: local preferences and the optional VirusTotal key -->
            <Grid Margin="20,16,20,14"
                  Visibility="{Binding IsChecked, ElementName=SettingsTab, Converter={StaticResource BoolToVis}}">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <StackPanel>
                    <TextBlock Text="Settings" Style="{StaticResource SectionTitle}" FontSize="17" />
                    <TextBlock Text="Everything here is stored on this machine, in %LocalAppData%\DoorNet\settings.json."
                               Style="{StaticResource Caption}"
                               Margin="0,4,0,0" />
                </StackPanel>

                <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Margin="0,14,0,0">
                    <StackPanel>

                        <Border Style="{StaticResource Card}">
                            <StackPanel>
                                <TextBlock Text="VirusTotal" Style="{StaticResource SectionTitle}" />
                                <TextBlock Text="{Binding ReputationStatusText}"
                                           Style="{StaticResource Caption}"
                                           Margin="0,4,0,0" />
                                <TextBlock Text="Optional. When a key is present, hosts that already look suspicious are checked against VirusTotal and the verdict adds up to +60 to their score. The key comes from here first, then the VIRUSTOTAL_API_KEY environment variable, then .env."
                                           Style="{StaticResource Caption}"
                                           TextWrapping="Wrap"
                                           Margin="0,8,0,0" />

                                <Grid Margin="0,12,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>

                                    <TextBox Grid.Column="0"
                                             Style="{StaticResource Input}"
                                             Text="{Binding ApiKeyInput, UpdateSourceTrigger=PropertyChanged}"
                                             ToolTip="Paste the VirusTotal API key. It is saved locally and never shown again in full." />
                                    <Button Grid.Column="1"
                                            Content="Save key"
                                            Style="{StaticResource GhostButton}"
                                            Padding="12,5"
                                            FontSize="11"
                                            Margin="8,0,6,0"
                                            Command="{Binding SaveApiKeyCommand}" />
                                    <Button Grid.Column="2"
                                            Content="Remove"
                                            Style="{StaticResource GhostButton}"
                                            Padding="12,5"
                                            FontSize="11"
                                            Command="{Binding ClearApiKeyCommand}" />
                                </Grid>

                                <TextBlock Text="Only suspicious hosts are looked up — never full URLs, never private addresses. Results are cached for a day and requests are spaced to respect the free tier."
                                           Style="{StaticResource Caption}"
                                           FontSize="10"
                                           TextWrapping="Wrap"
                                           Margin="0,6,0,0" />
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource Card}" Margin="0,12,0,0">
                            <StackPanel>
                                <TextBlock Text="Whitelisted hosts" Style="{StaticResource SectionTitle}" />
                                <TextBlock Text="Addresses you marked as safe from an alert. They are never scored again."
                                           Style="{StaticResource Caption}"
                                           Margin="0,4,0,0" />

                                <ItemsControl ItemsSource="{Binding WhitelistedHosts}" Margin="0,8,0,0">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border Padding="0,6"
                                                    BorderBrush="{DynamicResource LineSoftBrush}"
                                                    BorderThickness="0,0,0,1">
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*" />
                                                        <ColumnDefinition Width="Auto" />
                                                    </Grid.ColumnDefinitions>

                                                    <TextBlock Grid.Column="0"
                                                               Text="{Binding}"
                                                               FontSize="11.5"
                                                               Foreground="{DynamicResource TextPrimaryBrush}"
                                                               VerticalAlignment="Center" />

                                                    <Button Grid.Column="1"
                                                            Content="Remove"
                                                            Style="{StaticResource GhostButton}"
                                                            Padding="10,3"
                                                            FontSize="10.5"
                                                            Command="{Binding DataContext.RemoveWhitelistedHostCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                            CommandParameter="{Binding}" />
                                                </Grid>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>

                                <TextBlock Text="No hosts whitelisted yet."
                                           Margin="0,6,0,0">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock" BasedOn="{StaticResource Caption}">
                                            <Setter Property="Visibility" Value="Collapsed" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding HasWhitelistedHosts}" Value="False">
                                                    <Setter Property="Visibility" Value="Visible" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                            </StackPanel>
                        </Border>

                    </StackPanel>
                </ScrollViewer>
            </Grid>
        </Grid>

        <!-- Footer -->
        <Border Grid.Row="2"
                Height="34"
                Background="{DynamicResource HeaderBrush}"
                BorderBrush="{DynamicResource LineBrush}"
                BorderThickness="0,1,0,0">
            <Grid Margin="20,0">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Ellipse Width="5" Height="5" Fill="{DynamicResource TextMutedBrush}" Margin="0,0,7,0" VerticalAlignment="Center" />
                    <TextBlock Text="Samples every 1 s · in-process capture, no driver installed"
                               Style="{StaticResource Caption}"
                               FontSize="10.5" />
                </StackPanel>

                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                    <TextBlock Text="{Binding ElevationNote}" Style="{StaticResource Caption}" FontSize="10.5" />
                    <TextBlock Text="  ·  " Style="{StaticResource Caption}" FontSize="10.5" />
                    <TextBlock Text="{Binding VersionText}" Style="{StaticResource Caption}" FontSize="10.5" />
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Window>